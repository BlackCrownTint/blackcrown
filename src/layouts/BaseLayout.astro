---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  /** Optional social-share image (absolute or site-relative). */
  image?: string;
  /** One JSON-LD object or an array of them. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Set when the dark body chrome should differ; default jet black. */
  bodyBg?: string;
}

const { title, description, image = '/brand/logo-lockup.png', jsonLd, bodyBg = '#0A0A0C' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://www.blackcrowntint.net').href;
const ogImage = new URL(image, Astro.site ?? 'https://www.blackcrowntint.net').href;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Mark JS available ASAP so scroll-reveal only hides content when it can animate it back in. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Black Crown Tint" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0A0A0C" />
    <link rel="icon" type="image/png" href="/brand/crown-magenta.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap"
      rel="stylesheet"
    />

    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>

  <body style={`background:${bodyBg}`}>
    <div style="width:100%;overflow-x:hidden;background:#0A0A0C">
      <div class="bc-cursor" aria-hidden="true"></div>
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
