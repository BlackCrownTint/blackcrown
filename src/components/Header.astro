---
import { nav, routes, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---

<div class="bc-headwrap" id="top">
  <header class="bc-head">
    <a href={routes.home} data-magnetic style="display:flex;align-items:center;gap:10px;flex:none">
      <img src="/brand/crown-magenta.png" alt="Black Crown Tint" style="height:34px;width:auto;display:block" width="34" height="34" />
      <div style="line-height:1;color:#fff">
        <div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:14px;letter-spacing:0.06em">BLACK CROWN</div>
        <div style="font-family:'Playfair Display',serif;font-weight:700;font-size:9.5px;letter-spacing:0.46em;color:#C81878;margin-top:3px">TINT</div>
      </div>
    </a>

    <nav class="bc-desktop-nav" style="display:flex;align-items:center;gap:22px;font-size:14px">
      {nav.map((item) => (
        <a href={item.href} class:list={['bc-nav-link', { 'bc-active': isActive(item.href) }]}>{item.label}</a>
      ))}
    </nav>

    <div style="display:flex;align-items:center;gap:10px;flex:none">
      <a href={site.phoneHref} class="bc-icon-pill">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <span>{site.phone}</span>
      </a>
      <a href={routes.contact} data-magnetic class="bc-cta-btn" style="display:flex;align-items:center;gap:8px;background:#C81878;color:#fff;font-weight:700;font-size:13.5px;padding:11px 20px;border-radius:999px;font-family:'Poppins',sans-serif">Free Quote
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
      <button class="bc-burger" id="bcBurger" aria-label="Open menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </header>
</div>

<!-- Mobile drawer -->
<nav class="bc-mobile-nav" id="bcMobileNav" aria-label="Mobile">
  <button class="bc-mclose" id="bcClose" aria-label="Close menu">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
  {nav.map((item) => (
    <a href={item.href} class="bc-mnav">{item.label}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
  ))}
  <a href={routes.contact} class="bc-mnav" style="color:#C81878">Free Quote
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
  </a>
  <a href={site.phoneHref} class="bc-mnav">{site.phone}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
  </a>
</nav>

<script>
  const burger = document.getElementById('bcBurger');
  const close = document.getElementById('bcClose');
  const drawer = document.getElementById('bcMobileNav');
  const open = () => {
    drawer?.classList.add('bc-open');
    document.body.classList.add('bc-nav-open');
    burger?.setAttribute('aria-expanded', 'true');
  };
  const shut = () => {
    drawer?.classList.remove('bc-open');
    document.body.classList.remove('bc-nav-open');
    burger?.setAttribute('aria-expanded', 'false');
  };
  burger?.addEventListener('click', open);
  close?.addEventListener('click', shut);
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', shut));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') shut();
  });
</script>
