---
import { site } from '../data/site';
---
<section style="background:#0a0a0c;color:#fff;padding:72px 24px;text-align:center">
  <div style="max-width:720px;margin:auto">
    <p style="color:#c81878;font-weight:700;letter-spacing:.1em;margin-bottom:16px">YOUR EXPERIENCE MATTERS</p>
    <h2 style="font-size:clamp(28px,4vw,42px);line-height:1.15;margin-bottom:20px">Share your experience with Black Crown</h2>
    <p style="color:#a8a5ac;line-height:1.7;margin-bottom:28px">Your honest feedback helps other Jacksonville customers choose their window tinting service.</p>
    <a href={site.googleReviewHref} target="_blank" rel="noopener noreferrer" class="bc-cta-btn" style="display:inline-block;background:#c81878;color:#fff;padding:16px 28px;border-radius:10px;font-weight:700">Leave a Google review</a>
  </div>
</section>
