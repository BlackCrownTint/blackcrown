---
export interface Crumb {
  label: string;
  href?: string;
}
export interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
import { canonicalUrl } from '../lib/seo';
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl(Astro.url.pathname)}#breadcrumb`,
  itemListElement: items.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label,
    item: canonicalUrl(c.href ?? Astro.url.pathname) })) };
---

<nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:9px;font-size:13px;color:#A8A5AC;font-weight:500;margin-bottom:20px;flex-wrap:wrap">
  {items.map((c, i) => (
    <>
      {c.href ? (
        <a href={c.href} class="bc-foot-link" style="color:#A8A5AC">{c.label}</a>
      ) : (
        <span style="color:#C81878">{c.label}</span>
      )}
      {i < items.length - 1 && <span style="color:#3F3F46">/</span>}
    </>
  ))}
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
