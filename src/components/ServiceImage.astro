---
interface Props { kind: 'auto' | 'residential' | 'commercial'; priority?: boolean; }
const { kind, priority = false } = Astro.props;
const descriptions = {
  auto: 'Black Crown Tint project: tinted side windows on a gray pickup',
  residential: 'Black Crown Tint project: large residential windows viewed from the deck',
  commercial: 'Illustrative image of a modern commercial glass storefront',
};
const real = kind !== 'commercial';
const stem = real ? `${kind}-project` : kind;
---
<figure class="bc-service-image">
  <img src={`/images/${stem}-960.webp`}
    srcset={real ? `/images/${stem}-480.webp 480w, /images/${stem}-960.webp 768w` : `/images/${stem}-480.webp 480w, /images/${stem}-960.webp 960w, /images/${stem}-1440.webp 1440w`}
    sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 900px) 90vw, 560px"
    width={real ? 768 : 1440} height={real ? 1024 : 960} alt={descriptions[kind]}
    loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
  <figcaption>{real ? 'Black Crown Tint project' : 'Illustrative image'}</figcaption>
</figure>
<style>
  .bc-service-image { position:relative; width:100%; height:100%; min-height:240px; margin:0; overflow:hidden; border-radius:18px; background:#111114; }
  img { display:block; width:100%; height:100%; aspect-ratio:3/2; object-fit:cover; }
  figcaption { position:absolute; bottom:12px; right:12px; background:rgba(10,10,12,.82); padding:5px 9px; border-radius:6px; color:#f5f4f6; font-size:11px; }
</style>
