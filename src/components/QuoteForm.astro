---
export interface Props {
  /** Dark glass card (Home) vs light card (Contact). */
  dark?: boolean;
  withEmail?: boolean;
  services?: string[];
}

const {
  dark = true,
  withEmail = false,
  services = ['Service — Auto', 'Service — Residential', 'Service — Commercial', 'Service — Ceramic tint'],
} = Astro.props;

const cardBg = dark ? 'linear-gradient(180deg,#16161a,#101013)' : '#fff';
const cardBorder = dark ? 'rgba(255,255,255,0.1)' : '#E4E4E7';
const fieldBg = dark ? '#0A0A0C' : '#fff';
const fieldBorder = dark ? 'rgba(255,255,255,0.14)' : '#E4E4E7';
const fieldColor = dark ? '#fff' : '#0A0A0C';
const selColor = dark ? '#A8A5AC' : '#52525B';
const noteColor = dark ? '#52525B' : '#A8A5AC';

---

<form
  name="quote" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="website"
  class="bc-quote-form bc-reveal"
  data-reveal
  style={`background:${cardBg};border:1px solid ${cardBorder};border-radius:20px;padding:30px;display:flex;flex-direction:column;gap:13px;box-shadow:0 30px 60px -30px rgba(0,0,0,.8)`}
>
  <input type="hidden" name="form-name" value="quote" />
  <label hidden>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
  <input required name="name" aria-label="Your name" autocomplete="name" placeholder="Your name" style={`background:${fieldBg};border:1px solid ${fieldBorder};border-radius:11px;padding:14px 16px;color:${fieldColor};font-size:15px;outline:none`} />
  <input required type="tel" name="phone" aria-label="Phone number" autocomplete="tel" placeholder="Phone number" style={`background:${fieldBg};border:1px solid ${fieldBorder};border-radius:11px;padding:14px 16px;color:${fieldColor};font-size:15px;outline:none`} />
  {withEmail && (
    <input type="email" name="email" aria-label="Email address" autocomplete="email" placeholder="Email address" style={`background:${fieldBg};border:1px solid ${fieldBorder};border-radius:11px;padding:14px 16px;color:${fieldColor};font-size:15px;outline:none`} />
  )}
  <select name="service" aria-label="Service" style={`background:${fieldBg};border:1px solid ${fieldBorder};border-radius:11px;padding:14px 16px;color:${selColor};font-size:15px;outline:none`}>
    {services.map((s) => <option>{s}</option>)}
  </select>
  <textarea name="message" aria-label="Vehicle or message" placeholder="Vehicle / message (optional)" rows="3" style={`background:${fieldBg};border:1px solid ${fieldBorder};border-radius:11px;padding:14px 16px;color:${fieldColor};font-size:15px;outline:none;resize:vertical`}></textarea>
  <button type="submit" data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:15.5px;padding:16px;border:none;border-radius:11px;cursor:pointer">Request my free quote</button>
  <p style={`font-size:11.5px;color:${noteColor};text-align:center;font-weight:400`}>No spam. We reply within business hours.</p>
</form>
