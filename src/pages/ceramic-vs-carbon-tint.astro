---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { routes, site } from '../data/site';

const title = 'Ceramic vs Carbon Tint: Which Is Better? | Black Crown Tint';
const description =
  'Ceramic vs carbon window tint compared: heat rejection, UV, clarity, longevity, warranty and price. See which film is right for your car and budget in Florida.';

const rows = [
  { label: 'Heat rejection', carbon: 'Good', ceramic: 'Best' },
  { label: 'UV protection', carbon: 'Great', ceramic: '99%' },
  { label: 'Signal-safe', carbon: 'Yes', ceramic: 'Yes' },
  { label: "Won't fade / purple", carbon: 'Yes', ceramic: 'Yes' },
  { label: 'Clarity', carbon: 'Good', ceramic: 'Excellent' },
  { label: 'Warranty', carbon: '5 years', ceramic: 'Lifetime' },
  { label: 'Price', carbon: '$$', ceramic: '$$$' },
];

const chooseCeramic = [
  'You want the coolest cabin in the Florida heat.',
  'You keep your car for years and want lifetime coverage.',
  'You want max clarity and zero signal interference.',
];
const chooseCarbon = [
  'You want a quality film at a friendlier price.',
  'You mostly care about the look and solid UV protection.',
  "It's a shorter-term car you won't keep for years.",
];

const faqs = [
  { q: 'Is ceramic tint worth the extra cost?', a: "If you live with Florida heat and keep your car a few years, yes — ceramic rejects more heat, stays clearer and is backed by a lifetime warranty. If budget is tight or it's a short-term car, carbon is a strong value." },
  { q: 'Does carbon tint block heat?', a: 'Yes, carbon blocks UV and a fair amount of infrared heat — more than dyed film. Ceramic just blocks more of the infrared heat you actually feel.' },
  { q: 'Will either one block my phone signal?', a: 'No. Both 3M carbon and ceramic are non-metallic, so neither interferes with GPS, cellular or keyless-entry signals.' },
  { q: 'Which lasts longer?', a: 'Both resist fading far better than dyed film. Ceramic is the most durable and is backed by a lifetime warranty; carbon carries a 5-year warranty.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Ceramic vs Carbon Tint: Which Is Better?',
    description,
    author: { '@type': 'Organization', name: site.name },
    publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: site.url + '/brand/logo-lockup.png' } },
    mainEntityOfPage: site.url + routes.ceramicVsCarbon,
    dateModified: '2026-01-01',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden">
    <div style="position:absolute;top:-200px;right:-160px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.28),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div style="position:relative;max-width:820px;margin:0 auto;padding:56px 24px 52px;text-align:center">
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid rgba(200,24,120,0.4);border-radius:999px;padding:7px 15px;font-size:12px;font-weight:600;letter-spacing:0.05em;color:#fff;margin-bottom:22px;background:rgba(200,24,120,.1)"><span style="width:6px;height:6px;background:#C81878;border-radius:50%"></span>FILM GUIDE · 2026</div>
      <h1 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(32px,4.6vw,52px);line-height:1.06;letter-spacing:-0.01em;margin-bottom:20px">Ceramic vs Carbon Tint:<br>Which Is Better?</h1>
      <p style="font-size:18px;line-height:1.6;color:#A8A5AC;max-width:600px;margin:0 auto;font-weight:400"><strong style="color:#fff;font-weight:600">Quick answer:</strong> ceramic wins on heat rejection, clarity and longevity, and carries a lifetime warranty — it's the premium choice. Carbon is the smart-value pick that still blocks UV and won't fade. Pick ceramic for max comfort; carbon to save.</p>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section id="compare" style="background:#F5F4F6;padding:80px 24px">
    <div style="max-width:980px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="text-align:center;max-width:600px;margin:0 auto 40px"><div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">QUICK COMPARISON</div><h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-0.01em;color:#0A0A0C">Side by side</h2></div>
      <div class="bc-reveal bc-r-table" data-reveal style="background:#fff;border:1px solid #E4E4E7;border-radius:18px;overflow:hidden;box-shadow:0 14px 30px -20px rgba(0,0,0,.25)">
        <div style="display:grid;grid-template-columns:1.3fr 1fr 1fr;background:#0A0A0C;color:#fff;font-size:14px;font-weight:600"><div style="padding:18px 22px"></div><div style="padding:18px 14px;text-align:center;color:#A8A5AC">Carbon</div><div style="padding:18px 14px;text-align:center;color:#C81878">Ceramic</div></div>
        {rows.map((row) => (
          <div style="display:grid;grid-template-columns:1.3fr 1fr 1fr;border-top:1px solid #F4F4F5;font-size:14.5px"><div style="padding:16px 22px;color:#3F3F46;font-weight:500">{row.label}</div><div style="padding:16px 14px;text-align:center;color:#71717A">{row.carbon}</div><div style="padding:16px 14px;text-align:center;color:#0A0A0C;font-weight:700">{row.ceramic}</div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT IS CARBON / CERAMIC -->
  <section style="background:#0A0A0C;color:#fff;padding:84px 24px">
    <div class="bc-r-2" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:24px">
      <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:36px 32px;background:linear-gradient(180deg,#16161a,#101013)">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(168,165,172,.14);display:flex;align-items:center;justify-content:center;margin-bottom:20px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#A8A5AC" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path></svg></div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:24px;margin-bottom:12px">What is carbon tint?</h2>
        <p style="color:#A8A5AC;font-size:15.5px;line-height:1.7;font-weight:400">Carbon film uses carbon particles to block UV and some infrared heat. It has a deep matte-black look, won't fade or turn purple like cheap dyed film, and costs less than ceramic — a great value for everyday drivers who want a quality, lasting tint.</p>
      </div>
      <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid rgba(200,24,120,0.4);border-radius:18px;padding:36px 32px;background:linear-gradient(180deg,#1a1118,#101013)">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(200,24,120,.16);display:flex;align-items:center;justify-content:center;margin-bottom:20px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3z"></path><path d="m9 12 2 2 4-4"></path></svg></div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:24px;margin-bottom:12px">What is ceramic tint?</h2>
        <p style="color:#A8A5AC;font-size:15.5px;line-height:1.7;font-weight:400">Ceramic film uses nano-ceramic particles that block the most infrared heat and 99% of UV while staying optically clear. There's no metal, so it never interferes with GPS or phone signals, and no dye to break down — so it stays put for years. It's the premium tier, backed for life.</p>
      </div>
    </div>
  </section>

  <!-- HEAT TEST -->
  <section style="background:#111114;color:#fff;padding:84px 24px;border-top:1px solid rgba(255,255,255,.05)">
    <div class="bc-r-split" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center">
      <div class="bc-reveal" data-reveal>
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">THE HEAT REJECTION TEST</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(26px,3.2vw,36px);line-height:1.1;margin-bottom:16px">Feel the difference</h2>
        <p style="color:#A8A5AC;font-size:16.5px;line-height:1.7;font-weight:400;margin-bottom:14px">Put a heat lamp behind each film and hold your hand on the other side. Under ceramic, far less heat comes through than carbon or dyed — that's the infrared rejection you feel on a hot Florida day. See our demo on Instagram <a href={site.instagramHref} style="color:#C81878;font-weight:600">@blackcrowntint</a>.</p>
      </div>
      <div class="bc-reveal" data-reveal style="display:flex;flex-direction:column;gap:14px">
        <div><div style="display:flex;justify-content:space-between;font-size:13px;color:#A8A5AC;margin-bottom:7px"><span>Dyed</span><span style="color:#71717A">heat blocked</span></div><div style="height:14px;border-radius:99px;background:#262629;overflow:hidden"><div style="width:35%;height:100%;background:#52525B;border-radius:99px"></div></div></div>
        <div><div style="display:flex;justify-content:space-between;font-size:13px;color:#A8A5AC;margin-bottom:7px"><span>Carbon</span><span style="color:#71717A">heat blocked</span></div><div style="height:14px;border-radius:99px;background:#262629;overflow:hidden"><div style="width:62%;height:100%;background:#A8A5AC;border-radius:99px"></div></div></div>
        <div><div style="display:flex;justify-content:space-between;font-size:13px;color:#fff;margin-bottom:7px"><span style="font-weight:600">Ceramic</span><span style="color:#C81878;font-weight:600">heat blocked</span></div><div style="height:14px;border-radius:99px;background:#262629;overflow:hidden"><div style="width:92%;height:100%;background:linear-gradient(90deg,#920A5A,#C81878);border-radius:99px"></div></div></div>
        <p style="font-size:12px;color:#52525B;margin-top:4px">Illustrative — relative infrared heat rejection by film type.</p>
      </div>
    </div>
  </section>

  <!-- WHICH SHOULD YOU CHOOSE -->
  <section style="background:#F5F4F6;padding:84px 24px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="text-align:center;max-width:600px;margin:0 auto 44px"><div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">WHICH SHOULD YOU CHOOSE?</div><h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-0.01em;color:#0A0A0C">By budget &amp; use</h2></div>
      <div class="bc-r-2" style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
        <div class="bc-tile bc-reveal" data-tilt data-reveal style="background:#fff;border:1px solid #E4E4E7;border-radius:18px;padding:34px 30px">
          <h3 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:20px;color:#C81878;margin-bottom:16px">Choose ceramic if…</h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:12px">
            {chooseCeramic.map((li) => (
              <li style="display:flex;gap:11px;color:#3F3F46;font-size:15px;line-height:1.55"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px"><polyline points="20 6 9 17 4 12"></polyline></svg>{li}</li>
            ))}
          </ul>
        </div>
        <div class="bc-tile bc-reveal" data-tilt data-reveal style="background:#fff;border:1px solid #E4E4E7;border-radius:18px;padding:34px 30px">
          <h3 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:20px;color:#0A0A0C;margin-bottom:16px">Choose carbon if…</h3>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:12px">
            {chooseCarbon.map((li) => (
              <li style="display:flex;gap:11px;color:#3F3F46;font-size:15px;line-height:1.55"><span style="color:#A8A5AC;font-weight:700;flex:none">•</span>{li}</li>
            ))}
          </ul>
        </div>
      </div>
      <div class="bc-reveal" data-reveal style="text-align:center;margin-top:28px"><a href={routes.ceramic} style="color:#C81878;font-weight:600;font-size:15px;display:inline-flex;align-items:center;gap:8px">Learn more about ceramic tint <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a></div>
    </div>
  </section>

  <FAQ items={faqs} eyebrow="FAQ" heading="Ceramic vs carbon questions" dark={true} />

  <!-- CTA (custom: secondary links to Auto) -->
  <section style="background:#111114;color:#fff;padding:80px 24px;position:relative;overflow:hidden">
    <div style="position:absolute;bottom:-220px;left:-160px;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.24),transparent 62%);filter:blur(14px)"></div>
    <div class="bc-reveal" data-reveal style="position:relative;max-width:780px;margin:0 auto;text-align:center">
      <h2 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(28px,4vw,44px);line-height:1.08;letter-spacing:-0.015em;margin-bottom:18px">Still not sure? We'll help you choose</h2>
      <p style="color:#A8A5AC;font-size:18px;line-height:1.6;max-width:540px;margin:0 auto 30px;font-weight:400">Tell us your car and budget — we'll recommend the right film, no upsell. Free quote.</p>
      <div class="bc-r-stack" style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a href={routes.contact} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:10px">Get a free quote</a>
        <a href={routes.auto} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:16px;padding:16px 32px;border-radius:10px">Auto window tinting</a>
      </div>
    </div>
  </section>
</BaseLayout>
