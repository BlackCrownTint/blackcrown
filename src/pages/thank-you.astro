---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, routes } from '../data/site';
---
<BaseLayout title="Thank You | Black Crown Tint" description="Thank you for contacting Black Crown Tint.">
<section style="max-width:800px;margin:auto;text-align:center;padding:90px 24px;color:#fff">
  <h1 style="font-size:clamp(32px,5vw,52px);margin-bottom:24px">Thank you for reaching out</h1>
  <p style="color:#a8a5ac;line-height:1.7;margin-bottom:24px">Our team will follow up during business hours. Need help sooner? Call <a href={site.phoneHref} style="color:#fff">{site.phone}</a>.</p>
  <a href={routes.home} style="display:inline-block;background:#c81878;padding:16px 28px;border-radius:10px;font-weight:700">Back to home</a>
</section>
</BaseLayout>
