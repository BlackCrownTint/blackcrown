<script>
  // Draggable momentum carousel
  const track = document.getElementById('bcTrack');
  if (track) {
    let down = false, startX = 0, startScroll = 0, moved = false;
    let vel = 0, lastX = 0, raf: number | null = null;
    const stopMomentum = () => { if (raf) { cancelAnimationFrame(raf); raf = null; } };
    track.addEventListener('pointerdown', (e) => {
      down = true; moved = false; startX = e.clientX; lastX = e.clientX; startScroll = track.scrollLeft; vel = 0;
      stopMomentum(); track.classList.add('bc-grab');
    });
    track.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      track.scrollLeft = startScroll - dx;
      vel = e.clientX - lastX; lastX = e.clientX;
    });
    const release = () => {
      if (!down) return;
      down = false; track.classList.remove('bc-grab');
      let v = vel;
      const momentum = () => {
        if (Math.abs(v) < 0.4) { raf = null; return; }
        track.scrollLeft -= v; v *= 0.93; raf = requestAnimationFrame(momentum);
      };
      if (Math.abs(v) > 1) raf = requestAnimationFrame(momentum);
    };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointerleave', release);
    track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
    const step = 400;
    document.getElementById('bcPrev')?.addEventListener('click', () => { stopMomentum(); track.scrollBy({ left: -step, behavior: 'smooth' }); });
    document.getElementById('bcNext')?.addEventListener('click', () => { stopMomentum(); track.scrollBy({ left: step, behavior: 'smooth' }); });
  }
</script>
