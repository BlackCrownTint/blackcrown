        <div style="text-align:center;border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:28px 32px;background:linear-gradient(180deg,#16161a,#101013)"><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:42px;color:#fff">15%</div><div style="font-size:13px;color:#A8A5AC;margin-top:6px;font-weight:500">sedan rear</div></div>
      </div>
    </div>
  </section>

  <!-- ===== AREAS ===== -->
