---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, site } from '../data/site';

const title = 'Page not found | Black Crown Tint';
const description = "That page doesn't exist. Head back home or get a free window tint quote.";
---

<BaseLayout title={title} description={description}>
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden;min-height:70vh;display:flex;align-items:center">
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:680px;height:680px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.28),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div style="position:relative;max-width:680px;margin:0 auto;padding:90px 24px;text-align:center">
      <div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(72px,16vw,150px);line-height:1;letter-spacing:-0.02em;color:#fff">4<span style="color:#C81878">0</span>4</div>
      <h1 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(24px,3.4vw,34px);line-height:1.1;margin:14px 0 14px">Page not found</h1>
      <p style="color:#A8A5AC;font-size:17px;line-height:1.6;max-width:460px;margin:0 auto 30px">That page doesn't exist or has moved. Let's get you back on track.</p>
      <div class="bc-r-stack" style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a href={routes.home} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:15.5px;padding:16px 30px;border-radius:10px">Back to home</a>
        <a href={routes.contact} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:15.5px;padding:16px 28px;border-radius:10px">Get a free quote</a>
      </div>
      <p style="color:#71717A;font-size:14px;margin-top:22px">Or call <a href={site.phoneHref} style="color:#C81878;font-weight:600">{site.phone}</a></p>
    </div>
  </section>
</BaseLayout>
