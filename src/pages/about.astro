---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, site } from '../data/site';
const description='Meet Black Crown Tint, a mobile window tinting business serving Jacksonville and Northeast Florida. Explore our approach, real projects and how to plan your installation.';
const steps=[{title:'Start with your priorities',text:'Tell us about your vehicle or space and what matters most: heat, glare, privacy or the look of the glass.'},{title:'Compare the right options',text:'Discuss film options, the existing glass, installation needs and the quote before choosing your setup.'},{title:'Plan the installation',text:'Coordinate the location and appointment. We will discuss the access and working conditions needed for your project.'},{title:'Know what comes next',text:'Ask about film care, curing time and the warranty terms for the product selected for your installation.'}];
const jsonLd=[{'@context':'https://schema.org','@type':'AboutPage',name:'About Black Crown Tint',url:site.url+routes.about,description},{'@context':'https://schema.org','@type':'Organization',name:site.name,url:site.url,logo:site.url+'/brand/logo-lockup.webp',founder:site.founders.map(name=>({'@type':'Person',name})),sameAs:[site.instagramHref],telephone:site.phoneHref.replace('tel:','')}];
---
<BaseLayout title="About Black Crown Tint | Mobile Window Tinting Jacksonville" description={description} jsonLd={jsonLd}>
<section class="about-shell about-hero">
 <div><p class="about-kicker">MEET BLACK CROWN TINT</p><h1>Care for the glass.<br/><em>Respect for your space.</em></h1><p class="about-lead">Window film for your car, home and business. Mobile service with a personal approach, across Jacksonville and Northeast Florida.</p><div class="about-actions"><a class="about-primary" href={routes.contact}>Let's talk about your project &rarr;</a><a class="about-link" href="#approach">Get to know us &darr;</a></div></div>
 <figure class="about-photo about-hero-photo"><img src="/images/project-14.webp" width="768" height="1024" alt="Real Black Crown Tint project showing a gray pickup with tinted windows" loading="eager" fetchpriority="high"/><figcaption><span>BEHIND THE WORK</span>Real projects. Personal attention.</figcaption></figure>
</section>
<div class="about-strip about-shell"><span>Automotive</span><span>Residential</span><span>Commercial</span><span>Mobile service</span></div>
<section class="about-shell about-story" id="approach"><div><p class="about-kicker">THE PEOPLE BEHIND THE NAME</p><h2>Personal service.<br/>A considered approach.</h2><p class="about-founder">Founded by {site.founders.join(' & ')}.</p></div><div><p>Black Crown Tint brings automotive, residential and commercial window film services to customers across Northeast Florida. Our approach starts with understanding the glass and what you want to improve.</p><p>A darker look is only one part of the decision. Heat control, glare, privacy, visibility and the existing glass all influence which film makes sense. We help you work through those choices before planning the installation.</p><a class="about-link" href={routes.contact}>Ask us about your options &rarr;</a></div></section>
<section class="about-panel"><div class="about-shell"><div class="about-section-head"><div><p class="about-kicker">WHAT MATTERS TO US</p><h2>Good work starts<br/>before the film goes on.</h2></div><p>A practical conversation, care around your vehicle or space, and clear next steps.</p></div><div class="about-values"><article><span>01 / ADVICE</span><h3>Your priorities come first.</h3><p>Start with what you need from the glass. Compare visibility and film performance as separate decisions.</p></article><article><span>02 / PREPARATION</span><h3>Care around the work.</h3><p>The work starts with a considered setup and attention to the surfaces around the glass. Ask us how we prepare for your project.</p></article><article><span>03 / CLARITY</span><h3>Know what you are choosing.</h3><p>Discuss the selected film, quote, installation conditions, care guidance and applicable warranty terms.</p></article></div></div></section>
<section class="about-shell about-projects"><figure class="about-photo"><img src="/images/project-07.webp" width="768" height="1024" alt="Real residential window film project with large deck-facing windows" loading="lazy" decoding="async"/></figure><div><p class="about-kicker">THE WORK, IN REAL SETTINGS</p><h2>See the glass.<br/>See the details.</h2><p>From a Jeep and a pickup to large home windows, our project stories show the settings we work in and the glass from different perspectives.</p><a class="about-primary" href={routes.gallery}>Explore our success stories &rarr;</a><div class="about-mini-photo"><img src="/images/project-15.webp" width="768" height="1024" alt="Side view of a gray pickup with tinted windows" loading="lazy"/><span>Automotive and residential work.<br/>Photographed in real settings.</span></div></div></section>
<section class="about-shell about-process"><div class="about-section-head"><div><p class="about-kicker">FROM FIRST QUESTION TO INSTALLATION</p><h2>How to get started.</h2></div><p>You do not need to know a film name or percentage to begin. Tell us what you are trying to improve.</p></div><ol>{steps.map((step,i)=><li><span>0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></section>
<section class="about-shell about-planning"><div><p class="about-kicker">PLAN WITH CONFIDENCE</p><h2>Bring your questions.<br/>We'll talk through them.</h2><p>Film performance and warranty coverage depend on the selected product and installation. Ask us to explain the details for your quote.</p><div class="about-resource-links"><a href={routes.ceramicVsCarbon}>Ceramic vs. carbon &rarr;</a><a href={routes.floridaLaws}>Florida tint guidance &rarr;</a><a href={`${routes.residential}#savings-explorer`}>Explore home savings &rarr;</a></div></div><div class="about-mobile-card"><p class="about-kicker">WE COME TO YOU</p><h3>Jacksonville &<br/>Northeast Florida.</h3><p>Tell us your location and the project type so we can discuss service availability and the setup needed for a mobile installation.</p><a class="about-link" href={routes.serviceAreas}>See our service areas &rarr;</a><a class="about-primary" href={routes.contact}>Request your free quote &rarr;</a><a class="about-phone" href={site.phoneHref}>Call {site.phone}</a></div></section>
</BaseLayout>
<style>
.about-shell{max-width:1180px;margin:auto;padding-left:28px;padding-right:28px;color:#fff}.about-shell>*,.about-section-head>*{min-width:0}.about-kicker{font-size:11px;letter-spacing:.14em;font-weight:700;color:#ffb5dc}.about-hero{display:grid;grid-template-columns:1.15fr 1fr;gap:64px;align-items:center;padding-top:64px;padding-bottom:64px}.about-hero h1{font-size:clamp(42px,4.8vw,62px);font-weight:800;line-height:1.08;letter-spacing:-.045em;margin:24px 0}.about-hero h1 em{color:#ffb5dc;font-family:'Playfair Display',serif;font-weight:500}.about-lead{font-size:17px;line-height:1.8;color:#bdb9c4;max-width:480px}.about-actions{display:flex;flex-wrap:wrap;gap:20px;align-items:center;margin-top:30px}.about-primary{display:inline-flex;align-items:center;min-height:52px;padding:16px 22px;border-radius:10px;background:#c81878;font-weight:700;font-size:13px;line-height:1.5}.about-primary:hover{background:#aa1266}.about-link{display:inline-block;color:#ffb5dc;font-size:13px;font-weight:600;padding:12px 0}.about-photo{position:relative;margin:0;border-radius:22px;overflow:hidden;background:#17141b}.about-photo>img{display:block;width:100%;height:510px;object-fit:cover}.about-hero-photo>img{object-position:50% 46%}.about-photo figcaption{position:absolute;bottom:0;left:0;right:0;padding:70px 22px 24px;background:linear-gradient(transparent,#08080aef);font-size:18px;font-weight:600}.about-photo figcaption span{display:block;color:#ffb5dc;letter-spacing:.12em;font-size:10px;margin-bottom:10px}.about-strip{display:flex;flex-wrap:wrap;justify-content:space-between;gap:18px;border-top:1px solid #302b33;border-bottom:1px solid #302b33;padding-top:24px;padding-bottom:24px;color:#bdb9c4;font-size:13px}.about-story{display:grid;grid-template-columns:1fr 1fr;gap:70px;padding-top:80px;padding-bottom:80px;scroll-margin-top:100px}.about-shell h2{font-size:clamp(30px,3.5vw,44px);line-height:1.15;letter-spacing:-.035em;margin:18px 0 24px}.about-story>div:last-child p,.about-projects p:not(.about-kicker),.about-planning p:not(.about-kicker){font-size:15px;color:#bdb9c4;line-height:1.9;margin-bottom:18px}.about-founder{font-size:14px;color:#ddd6e2;border-left:2px solid #c81878;padding-left:16px}.about-panel{background:#17131b;padding:70px 0}.about-section-head{display:flex;justify-content:space-between;gap:60px;align-items:center;margin-bottom:28px}.about-section-head>p{max-width:350px;font-size:14px;line-height:1.8;color:#bdb9c4}.about-values{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.about-values article{border:1px solid #39313b;border-radius:16px;padding:28px 24px;background:#1e1922}.about-values article>span{font-size:10px;letter-spacing:.12em;color:#ffb5dc}.about-values h3{font-size:20px;line-height:1.4;margin:20px 0 14px}.about-values p{color:#bdb9c4;font-size:13px;line-height:1.85}.about-projects{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;padding-top:80px;padding-bottom:80px;border-bottom:1px solid #302b33}.about-mini-photo{display:flex;align-items:center;gap:20px;margin-top:28px;color:#bdb9c4;font-size:12px;line-height:1.8}.about-mini-photo img{width:110px;height:100px;object-fit:cover;border-radius:10px}.about-process{padding-top:70px;padding-bottom:70px}.about-process ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;list-style:none;padding:0;margin:0}.about-process li{border-top:1px solid #544151;padding-top:22px}.about-process li>span{color:#ffb5dc;font-size:22px}.about-process h3{font-size:16px;line-height:1.5;margin:16px 0 12px}.about-process li p{font-size:13px;line-height:1.85;color:#bdb9c4}.about-planning{display:grid;grid-template-columns:1fr 1fr;gap:80px;padding-top:40px;padding-bottom:80px}.about-resource-links{display:flex;flex-direction:column}.about-resource-links a{padding:15px 0;border-bottom:1px solid #302b33;color:#ffb5dc;font-size:13px;min-height:44px}.about-mobile-card{background:radial-gradient(at 0% 100%,#3d152b,#17131b 65%);border:1px solid #39313b;border-radius:20px;padding:34px}.about-mobile-card h3{font-size:32px;line-height:1.2;margin:20px 0}.about-mobile-card .about-primary{display:flex;margin-top:14px;justify-content:center}.about-phone{display:block;text-align:center;font-size:13px;margin-top:18px;color:#ded8e3}.about-shell a:focus-visible{outline:2px solid #ffb5dc;outline-offset:5px}
@media(max-width:850px){.about-hero,.about-story,.about-projects,.about-planning{gap:32px}.about-values{grid-template-columns:1fr}.about-process ol{grid-template-columns:repeat(2,minmax(0,1fr))}.about-section-head{gap:30px}.about-photo>img{height:450px}}
@media(max-width:650px){.about-hero,.about-story,.about-projects,.about-planning{grid-template-columns:1fr}.about-hero{padding-top:40px;padding-bottom:40px}.about-hero h1{font-size:42px}.about-photo>img{height:450px}.about-story,.about-projects{padding-top:48px;padding-bottom:48px}.about-section-head{flex-direction:column;align-items:flex-start;gap:0}.about-strip{font-size:12px;justify-content:flex-start;column-gap:24px}.about-planning{padding-bottom:50px}.about-mobile-card{padding:26px}.about-process ol{gap:22px}.about-panel{padding:45px 0}}
</style>
