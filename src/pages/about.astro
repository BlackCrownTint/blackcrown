---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTASection from '../components/CTASection.astro';
import { routes, site } from '../data/site';

const title = 'About Black Crown Tint | Jacksonville Window Tinting';
const description =
  'From tinting exotics in Dubai to your driveway in Jacksonville — Black Crown Tint brings premium 3M film, a lifetime warranty and 100% mobile service.';

const why = [
  { t: 'Quality first', d: 'Premium 3M film and pro finishes — no cheap shortcuts that bubble or fade.', svg: '<path d="M12 3l1.9 4.6 4.6.4-3.5 3 1.1 4.5L12 13.7 7.9 15.5 9 11 5.5 8l4.6-.4z"></path>' },
  { t: 'Warranty', d: 'Lifetime on 3M ceramic, 5 years on carbon — we stand behind every job.', svg: '<circle cx="12" cy="8" r="6"></circle><path d="M8.21 13.89 7 23l5-3 5 3-1.21-9.12"></path>' },
  { t: 'Personal attention', d: 'You deal with the owners directly — honest advice, no pushy upsells.', svg: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>' },
  { t: 'Exotic-grade finish', d: 'Trained on Ferrari, Porsche & Bugatti in Dubai — that finish, on your car.', svg: '<path d="M12 2 2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Black Crown Tint',
    url: site.url + routes.about,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    logo: site.url + '/brand/logo-lockup.png',
    founder: site.founders.map((f) => ({ '@type': 'Person', name: f })),
    sameAs: [site.instagramHref],
    telephone: '+19048930927',
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden">
    <div style="position:absolute;top:-200px;right:-160px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.3),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div class="bc-r-hero" style="position:relative;max-width:1180px;margin:0 auto;padding:60px 24px 64px;display:grid;grid-template-columns:1.05fr 0.95fr;gap:54px;align-items:center">
      <div>
        <Breadcrumb items={[{ label: 'Home', href: routes.home }, { label: 'About' }]} />
        <h1 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(36px,5vw,58px);line-height:1.03;letter-spacing:-0.01em;text-transform:uppercase;margin-bottom:22px">About<br>Black Crown</h1>
        <p style="font-size:18.5px;line-height:1.6;color:#A8A5AC;max-width:500px;font-weight:400">From tinting exotics in Dubai to your driveway in Jacksonville — the same precision, the same premium 3M film, now mobile across Northeast Florida.</p>
        <div style="display:flex;flex-wrap:wrap;gap:13px;margin-top:32px">
          <a href={routes.contact} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:15.5px;padding:16px 30px;border-radius:10px;display:flex;align-items:center;gap:10px">Get a free quote <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
          <a href={routes.gallery} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:15.5px;padding:16px 28px;border-radius:10px">See our work</a>
        </div>
      </div>
      <div style="position:relative;aspect-ratio:5/4;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);box-shadow:0 40px 80px -30px rgba(0,0,0,.8);background:repeating-linear-gradient(45deg,#161619,#161619 11px,#1d1d20 11px,#1d1d20 22px);display:flex;align-items:flex-end;justify-content:center;animation:bcFloat 7s ease-in-out infinite">
        <div style="position:absolute;inset:0;background:radial-gradient(110% 90% at 75% 12%,rgba(200,24,120,.22),transparent 58%)"></div>
        <div style="position:relative;font-family:'Poppins',sans-serif;font-size:13px;letter-spacing:0.04em;color:#C81878;background:rgba(10,10,12,0.7);border:1px dashed rgba(200,24,120,0.5);padding:8px 14px;border-radius:6px;margin-bottom:22px;font-weight:600">IMG · founders / team photo</div>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section style="background:#F5F4F6;padding:88px 24px">
    <div style="max-width:820px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="margin-bottom:8px"><div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">OUR STORY</div><h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.6vw,40px);line-height:1.1;letter-spacing:-0.01em;color:#0A0A0C">Built on craft, not shortcuts</h2></div>
      <div class="bc-reveal" data-reveal style="display:flex;flex-direction:column;gap:18px;margin-top:22px">
        <p style="color:#3F3F46;font-size:17px;line-height:1.75;font-weight:400">Black Crown Tint was founded on a simple belief: window tinting should be done right, priced honestly and backed by people who stand behind their work. After years tinting everything from daily drivers to exotics — Ferraris, Porsches and Bugattis — in Dubai, founders Camilo and Marco brought that high-end craft home to Jacksonville.</p>
        <p style="color:#3F3F46;font-size:17px;line-height:1.75;font-weight:400">That experience shows in every install: clean, factory-flush edges, the right film for your car or building, and a finish that looks like it came that way. We run fully mobile, so you get that same attention to detail in your own driveway — no waiting room, no rush.</p>
        <p style="color:#3F3F46;font-size:17px;line-height:1.75;font-weight:400">We're a new name in Northeast Florida, and we're building our reputation one car, home and storefront at a time — with premium 3M film and a warranty that has your back for the long haul.</p>
      </div>
    </div>
  </section>

  <!-- WHY DIFFERENT -->
  <section style="background:#0A0A0C;color:#fff;padding:88px 24px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="max-width:600px;margin-bottom:48px"><div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">WHY WE'RE DIFFERENT</div><h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(30px,3.8vw,44px);line-height:1.08;letter-spacing:-0.01em">What you get with Black Crown</h2></div>
      <div class="bc-r-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px">
        {why.map((w) => (
          <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:32px 26px;background:linear-gradient(180deg,#16161a,#101013)"><div style="width:48px;height:48px;border-radius:13px;background:rgba(200,24,120,.14);display:flex;align-items:center;justify-content:center;margin-bottom:20px"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={w.svg}></svg></div><h3 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:17px;margin-bottom:9px">{w.t}</h3><p style="color:#A8A5AC;font-size:14px;line-height:1.6;font-weight:400">{w.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- FILMS & WARRANTY + CREDENTIALS -->
  <section style="background:#F5F4F6;padding:88px 24px">
    <div class="bc-r-2" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:24px">
      <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid #E4E4E7;border-radius:18px;padding:38px 34px;background:#fff">
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">OUR FILMS &amp; WARRANTY</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:26px;margin-bottom:14px;color:#0A0A0C;line-height:1.15">Premium 3M, backed for life</h2>
        <p style="color:#52525B;font-size:15.5px;line-height:1.7;font-weight:400;margin-bottom:18px">We install 3M ceramic and carbon film — engineered to reject heat, block 99% of UV and hold their color without turning purple.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <div style="flex:1;min-width:130px;border:1px solid #E4E4E7;border-radius:12px;padding:16px 18px;background:#F5F4F6"><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:20px;color:#C81878">Lifetime</div><div style="font-size:13px;color:#52525B;margin-top:3px">on 3M ceramic</div></div>
          <div style="flex:1;min-width:130px;border:1px solid #E4E4E7;border-radius:12px;padding:16px 18px;background:#F5F4F6"><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:20px;color:#0A0A0C">5 years</div><div style="font-size:13px;color:#52525B;margin-top:3px">on 3M carbon</div></div>
        </div>
      </div>
      <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid #E4E4E7;border-radius:18px;padding:38px 34px;background:#fff">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(200,24,120,.1);display:flex;align-items:center;justify-content:center;margin-bottom:18px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3z"></path><path d="m9 12 2 2 4-4"></path></svg></div>
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:12px">LICENSED &amp; INSURED</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:26px;margin-bottom:14px;color:#0A0A0C;line-height:1.15">Professional &amp; accountable</h2>
        <p style="color:#52525B;font-size:15.5px;line-height:1.7;font-weight:400">We're fully licensed and insured, and every install meets Florida's legal tint limits. You get peace of mind on the work, the film and the law.</p>
      </div>
    </div>
  </section>

  <CTASection heading="Let's tint it right" sub="Serving Jacksonville and Northeast Florida — 100% mobile. Get your free quote today." />
</BaseLayout>
