---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import { routes, site } from '../../data/site';

const title = 'Residential Window Tinting Jacksonville | Black Crown Tint';
const description =
  'Residential window tinting in Jacksonville, FL. 3M home film cuts heat, lowers energy bills, blocks 99% of UV and adds privacy. Lifetime warranty. Free quote.';

const benefits = [
  { t: 'Lower energy bills', d: 'Reject solar heat so your A/C runs less and rooms stay evenly cool.', svg: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path>' },
  { t: 'Protect interiors', d: 'Block 99% of UV to stop floors, furniture and art from fading.', svg: '<path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3z"></path><path d="m9 12 2 2 4-4"></path>' },
  { t: 'Add privacy', d: 'Daytime privacy film keeps your home yours without losing the view.', svg: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path><circle cx="12" cy="12" r="3"></circle><line x1="3" y1="3" x2="21" y2="21"></line>' },
  { t: 'Reduce glare', d: 'Cut harsh glare on TVs and screens while keeping natural light.', svg: '<circle cx="12" cy="12" r="3"></circle><path d="M3 12s3-7 9-7 9 7 9 7M3 12s3 7 9 7M21 12l-2 2"></path>' },
];

const films = [
  { t: 'Solar control', d: 'Maximum heat and UV rejection while keeping a clear view out.' },
  { t: 'Privacy', d: 'Frosted or mirrored finishes for bathrooms, offices and ground floors.' },
  { t: 'Security', d: 'Thicker film that helps hold glass together against impact and break-ins.' },
  { t: 'Decorative', d: 'Frosted patterns and gradients for style and partial privacy.' },
];

const steps = [
  { n: '01', t: 'In-home quote', d: 'We measure your windows and recommend the right film and finish.' },
  { n: '02', t: 'Prep & protect', d: 'We clean glass and protect your floors and furnishings before we start.' },
  { n: '03', t: 'Precision install', d: 'Film cut to each pane and finished with clean, even edges.' },
  { n: '04', t: 'Cure & warranty', d: 'Backed by warranty — lifetime on 3M ceramic, 5 years on carbon.' },
];

const faqs = [
  { q: 'Is home window tint worth it in Florida?', a: "Absolutely. Florida's sun drives up cooling costs and fades interiors year-round. 3M solar film cuts heat and blocks 99% of UV, so you save on A/C and protect your furnishings — it pays back over time." },
  { q: 'Will tint make my rooms dark?', a: 'No. Modern solar films reject heat and UV while keeping the glass clear, so you keep your natural light and your view. We can also go lighter or darker depending on the room.' },
  { q: 'How much can I save on energy?', a: 'Savings depend on your home, windows and sun exposure. Solar film reduces heat gain on sun-facing glass, which eases the load on your A/C.' },
  { q: 'Does home tint come with a warranty?', a: 'Yes — residential 3M film installs are backed by warranty, with a lifetime warranty on ceramic film.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Residential Window Tinting',
    provider: { '@type': 'LocalBusiness', name: site.name, telephone: '+19048930927', areaServed: 'Jacksonville, FL' },
    areaServed: 'Jacksonville, FL and Northeast Florida',
    url: site.url + routes.residential,
    description: 'Residential 3M window film in Jacksonville, FL — solar, privacy, security and decorative film with a lifetime ceramic warranty.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden">
    <div style="position:absolute;top:-200px;right:-160px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.3),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div class="bc-r-hero" style="position:relative;max-width:1180px;margin:0 auto;padding:60px 24px 64px;display:grid;grid-template-columns:1.05fr 0.95fr;gap:54px;align-items:center">
      <div>
        <Breadcrumb items={[{ label: 'Home', href: routes.home }, { label: 'Residential Window Tinting' }]} />
        <h1 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(36px,5vw,58px);line-height:1.03;letter-spacing:-0.01em;text-transform:uppercase;margin-bottom:22px">Residential<br>Window Tinting</h1>
        <p style="font-size:18.5px;line-height:1.6;color:#A8A5AC;max-width:500px;font-weight:400">Cooler rooms, lower power bills and floors and furniture that don't fade. 3M home film that blocks 99% of UV and adds privacy — installed across Jacksonville.</p>
        <div style="display:flex;flex-wrap:wrap;gap:13px;margin-top:32px">
          <a href={routes.contact} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:15.5px;padding:16px 30px;border-radius:10px;display:flex;align-items:center;gap:10px">Get a free quote <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
          <a href={site.phoneHref} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:15.5px;padding:16px 28px;border-radius:10px;display:flex;align-items:center;gap:10px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>{site.phone}</a>
        </div>
      </div>
      <div style="position:relative;aspect-ratio:5/4;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);box-shadow:0 40px 80px -30px rgba(0,0,0,.8);background:linear-gradient(160deg,#1a2230,#1a1620);animation:bcFloat 7s ease-in-out infinite">
        <div style="position:absolute;inset:0;background:radial-gradient(120% 90% at 80% 12%,rgba(200,24,120,.26),transparent 56%)"></div>
        <div style="position:absolute;left:8%;top:14%;right:8%;bottom:0;display:grid;grid-template-columns:1fr 1fr;gap:10px"><div style="border-radius:10px 10px 0 0;background:linear-gradient(180deg,rgba(255,255,255,.1),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.12);border-bottom:none"></div><div style="border-radius:10px 10px 0 0;background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.01));border:1px solid rgba(255,255,255,.1);border-bottom:none"></div></div>
        <div style="position:absolute;top:18px;left:18px;width:50px;height:50px;border-radius:14px;background:rgba(255,255,255,.95);display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px -8px rgba(200,24,120,.5)"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"></path><path d="M5 10v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9"></path><path d="M9 20v-6h6v6"></path></svg></div>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section style="background:#F5F4F6;padding:88px 24px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="max-width:600px;margin-bottom:48px">
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">BENEFITS FOR YOUR HOME</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(30px,3.8vw,44px);line-height:1.08;letter-spacing:-0.01em;color:#0A0A0C">Comfort, savings and protection</h2>
      </div>
      <div class="bc-r-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px">
        {benefits.map((b) => (
          <div class="bc-tile bc-reveal" data-tilt data-reveal style="background:#fff;border:1px solid #E4E4E7;border-radius:18px;padding:30px 26px"><div style="width:48px;height:48px;border-radius:13px;background:rgba(200,24,120,.1);display:flex;align-items:center;justify-content:center;margin-bottom:18px"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={b.svg}></svg></div><h3 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:17px;margin-bottom:9px;color:#0A0A0C">{b.t}</h3><p style="color:#52525B;font-size:14px;line-height:1.6;font-weight:400">{b.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- FILM TYPES -->
  <section style="background:#0A0A0C;color:#fff;padding:88px 24px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="max-width:600px;margin-bottom:46px">
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">TYPES OF HOME FILM</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-0.01em">A 3M film for every window</h2>
      </div>
      <div class="bc-r-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px">
        {films.map((f) => (
          <div class="bc-tile bc-reveal" data-tilt data-reveal style="background:linear-gradient(180deg,#16161a,#101013);border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:28px 24px"><h3 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;margin-bottom:9px">{f.t}</h3><p style="color:#A8A5AC;font-size:14px;line-height:1.6;font-weight:400">{f.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section style="background:#F5F4F6;padding:88px 24px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="max-width:600px;margin-bottom:48px">
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">OUR PROCESS</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(30px,3.8vw,44px);line-height:1.08;letter-spacing:-0.01em;color:#0A0A0C">Clean install, minimal disruption</h2>
      </div>
      <div class="bc-r-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px">
        {steps.map((s) => (
          <div class="bc-tile bc-reveal" data-tilt data-reveal style="background:#fff;border:1px solid #E4E4E7;border-radius:18px;padding:30px 24px"><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:30px;color:#C81878;margin-bottom:12px">{s.n}</div><h3 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:17px;margin-bottom:8px;color:#0A0A0C">{s.t}</h3><p style="color:#52525B;font-size:14px;line-height:1.6;font-weight:400">{s.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} eyebrow="FAQ" heading="Home tint questions" dark={true} />

  <CTASection bg="#111114" heading="Cooler home, lower bills" sub="Protect your home from the Florida sun. Get a free in-home quote today." />
</BaseLayout>
