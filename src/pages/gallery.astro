---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { routes, site } from '../data/site';

const title = 'Window Tint Gallery | Black Crown Tint Jacksonville';
const description =
  'See recent 3M window tint installs across Jacksonville and the First Coast — auto, residential and commercial. Filter our work by type.';

const filters = [
  { key: 'all', label: 'All work' },
  { key: 'auto', label: 'Auto' },
  { key: 'residential', label: 'Residential' },
  { key: 'commercial', label: 'Commercial' },
];

const shots = [
  { cat: 'Auto', key: 'auto', title: 'Sedan · Ceramic', ph: 'sedan ceramic', bg: 'linear-gradient(150deg,#1a1a1f,#2a1622)' },
  { cat: 'Auto', key: 'auto', title: 'SUV · Full tint', ph: 'SUV full', bg: 'linear-gradient(150deg,#181820,#221a2a)' },
  { cat: 'Auto', key: 'auto', title: 'Exotic · Detail', ph: 'exotic', bg: 'linear-gradient(150deg,#1a1620,#2a1424)' },
  { cat: 'Residential', key: 'residential', title: 'Home · Solar film', ph: 'living room', bg: 'linear-gradient(150deg,#1a1a1f,#1c2230)' },
  { cat: 'Residential', key: 'residential', title: 'Patio doors', ph: 'patio doors', bg: 'linear-gradient(150deg,#181a22,#201a26)' },
  { cat: 'Residential', key: 'residential', title: 'Privacy film', ph: 'privacy', bg: 'linear-gradient(150deg,#191921,#241620)' },
  { cat: 'Commercial', key: 'commercial', title: 'Storefront', ph: 'storefront', bg: 'linear-gradient(150deg,#191921,#2a1622)' },
  { cat: 'Commercial', key: 'commercial', title: 'Office glass', ph: 'office', bg: 'linear-gradient(150deg,#181820,#1c1622)' },
  { cat: 'Commercial', key: 'commercial', title: 'Restaurant', ph: 'restaurant', bg: 'linear-gradient(150deg,#1a1620,#221a28)' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Black Crown Tint — Work Gallery',
  url: site.url + routes.gallery,
  description,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO + FILTERS -->
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden">
    <div style="position:absolute;top:-200px;right:-160px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.28),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div style="position:relative;max-width:820px;margin:0 auto;padding:58px 24px 18px;text-align:center">
      <div style="display:flex;justify-content:center"><Breadcrumb items={[{ label: 'Home', href: routes.home }, { label: 'Gallery' }]} /></div>
      <h1 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(34px,4.8vw,56px);line-height:1.04;letter-spacing:-0.01em;text-transform:uppercase;margin-bottom:18px">Our Work</h1>
      <p style="font-size:18px;line-height:1.6;color:#A8A5AC;max-width:540px;margin:0 auto;font-weight:400">Recent 3M tint installs across Jacksonville and the First Coast. Filter by type below.</p>
    </div>
    <div style="position:relative;max-width:1180px;margin:0 auto;padding:30px 24px 44px;display:flex;gap:11px;justify-content:center;flex-wrap:wrap">
      {filters.map((f) => (
        <button class="bc-filter bc-gallery-filter" data-key={f.key} style="border:1px solid rgba(255,255,255,0.16);border-radius:999px;padding:11px 22px;font-size:14px;font-weight:600;cursor:pointer;background:rgba(255,255,255,0.04);color:#D4D4D8;font-family:'Poppins',sans-serif">{f.label}</button>
      ))}
    </div>
  </section>

  <!-- GRID -->
  <section style="background:#F5F4F6;padding:48px 24px 80px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-r-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px">
        {shots.map((s) => (
          <div class="bc-shot" data-key={s.key} style="border-radius:18px;overflow:hidden;background:#0A0A0C;box-shadow:0 16px 36px -24px rgba(0,0,0,.4);position:relative;display:block">
            <div style={`aspect-ratio:4/3;background:${s.bg};position:relative;overflow:hidden`}>
              <div style="position:absolute;inset:0;background:radial-gradient(110% 80% at 75% 15%,rgba(200,24,120,.26),transparent 58%)"></div>
              <div style="position:absolute;left:0;bottom:0;width:100%;height:52%;background:linear-gradient(180deg,transparent,rgba(10,10,12,.72))"></div>
              <span style="position:absolute;top:16px;left:16px;background:rgba(255,255,255,.95);color:#0A0A0C;font-size:11px;font-weight:700;letter-spacing:.05em;padding:6px 12px;border-radius:999px;text-transform:uppercase">{s.cat}</span>
              <div style="position:absolute;left:18px;right:18px;bottom:16px;display:flex;align-items:flex-end;justify-content:space-between;gap:10px">
                <span style="color:#fff;font-family:'Poppins',sans-serif;font-weight:600;font-size:16px">{s.title}</span>
                <span style="font-size:10px;color:#C81878;font-weight:600;border:1px dashed rgba(200,24,120,.5);padding:5px 9px;border-radius:6px;background:rgba(10,10,12,.4);white-space:nowrap">IMG · {s.ph}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p style="text-align:center;color:#71717A;font-size:13px;margin-top:30px;font-weight:400">Real project photos coming soon — we have them; drop them in here. Each finished job = content for Gallery, Google &amp; Instagram.</p>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:#0A0A0C;color:#fff;padding:84px 24px;position:relative;overflow:hidden">
    <div style="position:absolute;bottom:-220px;left:-160px;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.24),transparent 62%);filter:blur(14px)"></div>
    <div class="bc-reveal" data-reveal style="position:relative;max-width:780px;margin:0 auto;text-align:center">
      <h2 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(28px,4vw,44px);line-height:1.08;letter-spacing:-0.015em;margin-bottom:18px">Want your car in here next?</h2>
      <p style="color:#A8A5AC;font-size:18px;line-height:1.6;max-width:540px;margin:0 auto 30px;font-weight:400">Book your install and join our gallery. Get a free quote today.</p>
      <div class="bc-r-stack" style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a href={routes.contact} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:10px">Get a free quote</a>
        <a href={site.instagramHref} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:16px;padding:16px 32px;border-radius:10px;display:flex;align-items:center;gap:9px"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>@blackcrowntint</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.bc-gallery-filter'));
  const shots = Array.from(document.querySelectorAll<HTMLElement>('.bc-shot'));
  const setActive = (key: string) => {
    btns.forEach((b) => {
      const on = b.dataset.key === key;
      b.style.background = on ? '#C81878' : 'rgba(255,255,255,0.04)';
      b.style.color = on ? '#fff' : '#D4D4D8';
      b.style.borderColor = on ? '#C81878' : 'rgba(255,255,255,0.16)';
    });
    shots.forEach((s) => {
      s.style.display = key === 'all' || s.dataset.key === key ? 'block' : 'none';
    });
  };
  btns.forEach((b) => b.addEventListener('click', () => setActive(b.dataset.key || 'all')));
  setActive('all');
</script>
