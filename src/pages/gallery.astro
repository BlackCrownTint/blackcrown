---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceImage from '../components/ServiceImage.astro';
import { routes, site } from '../data/site';
const services = [
  { kind: 'auto' as const, title: 'Auto window tinting', href: routes.auto },
  { kind: 'residential' as const, title: 'Residential window tinting', href: routes.residential },
  { kind: 'commercial' as const, title: 'Commercial window tinting', href: routes.commercial },
];
---
<BaseLayout title="Window Tint Inspiration | Black Crown Tint Jacksonville" description="Explore auto, residential and commercial window tinting options from Black Crown Tint in Jacksonville.">
  <section style="padding:64px 24px;color:#fff;text-align:center;max-width:900px;margin:auto">
    <h1 style="font-size:clamp(34px,5vw,56px);line-height:1.1;margin-bottom:20px">Window tint inspiration</h1>
    <p style="color:#a8a5ac;line-height:1.7">Explore the possibilities for your car, home and business. These AI-generated images illustrate our services and do not show completed Black Crown Tint projects.</p>
  </section>
  <section style="background:#f5f4f6;padding:48px 24px 64px">
    <div class="bc-r-3" style="max-width:1180px;margin:auto;display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
      {services.map(s => <a href={s.href} style="background:#fff;border-radius:18px;overflow:hidden"><ServiceImage kind={s.kind} /><h2 style="padding:22px;font-size:20px;color:#0a0a0c">{s.title}</h2></a>)}
    </div>
  </section>
  <section style="padding:64px 24px;text-align:center;color:#fff">
    <h2 style="font-size:30px;margin-bottom:24px">Find the right film for your space</h2>
    <a href={routes.contact} class="bc-cta-btn" style="display:inline-block;background:#c81878;padding:16px 28px;border-radius:10px;font-weight:700">Get a free quote</a>
    <p style="margin-top:24px"><a href={site.instagramHref} style="color:#a8a5ac">Follow {site.instagram}</a></p>
  </section>
</BaseLayout>
