---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { routes, site } from '../data/site';

const title = 'Ceramic Window Tint Jacksonville | Black Crown Tint';
const description =
  'Premium 3M ceramic window tint in Jacksonville, FL. Maximum heat rejection, 99% UV blocked, crystal clarity and no signal interference. Lifetime warranty.';

const whatPoints = [
  { t: 'Blocks infrared heat', d: 'The heat you actually feel — rejected at the glass.', svg: '<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"></path>' },
  { t: '99% UV blocked', d: 'Protects skin and interior from fading.', svg: '<path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3z"></path><path d="m9 12 2 2 4-4"></path>' },
  { t: 'Signal-safe & clear', d: 'No interference, no haze — just a clean finish.', svg: '<path d="M5 12.55a11 11 0 0 1 14 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"></path>' },
];

const compareRows = [
  ['Heat rejection', 'Low', 'Good', 'Best'],
  ['UV protection', 'Good', 'Great', '99%'],
  ['Signal-safe', 'Yes', 'Yes', 'Yes'],
  ["Won't fade/purple", 'No', 'Yes', 'Yes'],
  ['Warranty', '—', '5 yrs', 'Lifetime'],
];

const goCeramic = [
  'You park in the Florida sun and want the coolest possible cabin.',
  'You keep your cars long and want film that lasts without fading.',
  'You want max clarity and zero signal interference.',
];
const carbonEnough = [
  "You're on a tighter budget but still want a quality, lasting film.",
  'You mostly want the look and UV protection over max heat rejection.',
  "It's a short-term vehicle you won't keep for years.",
];

const faqs = [
  { q: 'Is ceramic tint darker than regular tint?', a: "Not necessarily. Ceramic comes in the same range of shades — its advantage is heat rejection, not darkness. You can get a light ceramic that still blocks a lot of heat, or a dark one, all within Florida's legal limits." },
  { q: 'Will ceramic tint block my phone or GPS?', a: "No. 3M ceramic film is non-metallic, so it won't interfere with GPS, cellular, Bluetooth or keyless-entry signals — unlike older metallic films." },
  { q: 'Does ceramic tint really keep the car cooler?', a: 'Yes. Ceramic rejects more infrared heat — the heat you feel — than dyed or carbon film, so the cabin stays noticeably cooler and your A/C works less in the Florida sun.' },
  { q: 'How long does ceramic tint last?', a: "3M ceramic film holds its color and performance for years and won't fade or turn purple. It's backed by a lifetime warranty." },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Ceramic Window Tint',
    provider: { '@type': 'LocalBusiness', name: site.name, telephone: '+19048930927', areaServed: 'Jacksonville, FL' },
    areaServed: 'Jacksonville, FL and Northeast Florida',
    url: site.url + routes.ceramic,
    description: 'Premium 3M nano-ceramic window tint in Jacksonville, FL — maximum infrared heat rejection, 99% UV protection and a lifetime warranty.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden">
    <div style="position:absolute;top:-200px;right:-160px;width:660px;height:660px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.32),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div class="bc-r-hero" style="position:relative;max-width:1180px;margin:0 auto;padding:60px 24px 64px;display:grid;grid-template-columns:1.05fr 0.95fr;gap:54px;align-items:center">
      <div>
        <Breadcrumb items={[{ label: 'Home', href: routes.home }, { label: 'Ceramic Window Tint' }]} />
        <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid rgba(200,24,120,0.45);border-radius:999px;padding:7px 15px;font-size:12px;font-weight:600;letter-spacing:0.05em;color:#fff;margin-bottom:22px;background:rgba(200,24,120,.1)"><span style="width:6px;height:6px;background:#C81878;border-radius:50%;animation:bcPulse 2s ease-in-out infinite"></span>OUR PREMIUM TIER</div>
        <h1 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(36px,5vw,58px);line-height:1.03;letter-spacing:-0.01em;text-transform:uppercase;margin-bottom:22px">Ceramic<br>Window Tint</h1>
        <p style="font-size:18.5px;line-height:1.6;color:#A8A5AC;max-width:500px;font-weight:400">The premium choice for heat rejection. Maximum comfort, crystal clarity and zero interference with your GPS, phone or keyless entry — backed for life.</p>
        <div style="display:flex;flex-wrap:wrap;gap:13px;margin-top:32px">
          <a href={routes.contact} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:15.5px;padding:16px 30px;border-radius:10px;display:flex;align-items:center;gap:10px">Get a free quote <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
          <a href={site.phoneHref} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:15.5px;padding:16px 28px;border-radius:10px;display:flex;align-items:center;gap:10px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>{site.phone}</a>
        </div>
      </div>
      <div style="position:relative;aspect-ratio:5/4;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);box-shadow:0 40px 80px -30px rgba(0,0,0,.8);background:linear-gradient(160deg,#1a1620,#2a1424);animation:bcFloat 7s ease-in-out infinite">
        <div style="position:absolute;inset:0;background:radial-gradient(110% 90% at 75% 18%,rgba(200,24,120,.34),transparent 58%)"></div>
        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:140px;height:140px;border-radius:50%;border:1.5px solid rgba(200,24,120,.4);display:flex;align-items:center;justify-content:center"><div style="width:96px;height:96px;border-radius:50%;border:1.5px solid rgba(200,24,120,.6);display:flex;align-items:center;justify-content:center"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3z"></path><path d="m9 12 2 2 4-4"></path></svg></div></div>
      </div>
    </div>
  </section>

  <!-- WHAT IS -->
  <section style="background:#F5F4F6;padding:88px 24px">
    <div class="bc-r-split" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center">
      <div class="bc-reveal" data-reveal>
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">WHAT IS CERAMIC TINT?</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-0.01em;margin-bottom:16px;color:#0A0A0C">Nano-ceramic, not metal or dye</h2>
        <p style="color:#52525B;font-size:16.5px;line-height:1.7;font-weight:400;margin-bottom:14px">Ceramic film uses microscopic ceramic particles instead of dye or metal. Those particles block infrared heat and UV while staying optically clear — serious heat rejection without a dark, mirrored or signal-blocking look.</p>
        <p style="color:#52525B;font-size:16.5px;line-height:1.7;font-weight:400">Because there's no metal, it never interferes with electronics, and because there's no dye to break down, it won't fade or turn purple.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:14px">
        {whatPoints.map((p) => (
          <div class="bc-tile bc-reveal" data-tilt data-reveal style="display:flex;gap:16px;align-items:center;background:#fff;border:1px solid #E4E4E7;border-radius:16px;padding:20px 22px"><div style="width:48px;height:48px;border-radius:13px;background:rgba(200,24,120,.1);display:flex;align-items:center;justify-content:center;flex:none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={p.svg}></svg></div><div><div style="font-weight:700;font-size:16px;color:#0A0A0C">{p.t}</div><div style="color:#52525B;font-size:14px;line-height:1.5">{p.d}</div></div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section style="background:#0A0A0C;color:#fff;padding:88px 24px">
    <div style="max-width:980px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="text-align:center;max-width:600px;margin:0 auto 44px">
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">HOW IT COMPARES</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-0.01em">Ceramic vs carbon vs dyed</h2>
      </div>
      <div class="bc-reveal bc-r-table" data-reveal style="background:linear-gradient(180deg,#16161a,#101013);border:1px solid rgba(255,255,255,0.1);border-radius:18px;overflow:hidden">
        <div style="display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;background:rgba(0,0,0,.4);font-size:13.5px;font-weight:600"><div style="padding:18px 20px"></div><div style="padding:18px 12px;text-align:center;color:#A8A5AC">Dyed</div><div style="padding:18px 12px;text-align:center;color:#A8A5AC">Carbon</div><div style="padding:18px 12px;text-align:center;color:#C81878">Ceramic</div></div>
        {compareRows.map((r) => (
          <div style="display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;border-top:1px solid rgba(255,255,255,.06);font-size:14px"><div style="padding:16px 20px;color:#D4D4D8">{r[0]}</div><div style="padding:16px 12px;text-align:center;color:#71717A">{r[1]}</div><div style="padding:16px 12px;text-align:center;color:#71717A">{r[2]}</div><div style="padding:16px 12px;text-align:center;font-weight:700">{r[3]}</div></div>
        ))}
      </div>
      <div class="bc-reveal" data-reveal style="text-align:center;margin-top:24px"><a href={routes.ceramicVsCarbon} style="color:#C81878;font-weight:600;font-size:15px;display:inline-flex;align-items:center;gap:8px">Read the full ceramic vs carbon guide <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a></div>
    </div>
  </section>

  <!-- IS IT WORTH IT -->
  <section style="background:#111114;color:#fff;padding:88px 24px;position:relative;overflow:hidden;border-top:1px solid rgba(255,255,255,.05)">
    <div style="position:absolute;top:-140px;right:-120px;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.18),transparent 65%);filter:blur(12px)"></div>
    <div style="position:relative;max-width:1180px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="max-width:600px;margin-bottom:44px">
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">THE HONEST TAKE</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(30px,3.8vw,44px);line-height:1.08;letter-spacing:-0.01em">Is ceramic worth it?</h2>
      </div>
      <div class="bc-r-split" style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
        <div class="bc-reveal" data-reveal style="border:1px solid rgba(200,24,120,0.4);border-radius:18px;padding:32px 30px;background:linear-gradient(180deg,#1a1118,#101013)">
          <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;color:#C81878;margin-bottom:16px">Go ceramic if…</div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:12px">
            {goCeramic.map((li) => (
              <li style="display:flex;gap:11px;color:#D4D4D8;font-size:15px;line-height:1.55"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px"><polyline points="20 6 9 17 4 12"></polyline></svg>{li}</li>
            ))}
          </ul>
        </div>
        <div class="bc-reveal" data-reveal style="border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:32px 30px;background:linear-gradient(180deg,#16161a,#101013)">
          <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;color:#A8A5AC;margin-bottom:16px">Carbon may be enough if…</div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:12px">
            {carbonEnough.map((li) => (
              <li style="display:flex;gap:11px;color:#D4D4D8;font-size:15px;line-height:1.55"><span style="color:#A8A5AC;font-weight:700;flex:none">•</span>{li}</li>
            ))}
          </ul>
        </div>
      </div>
      <p class="bc-reveal" data-reveal style="color:#A8A5AC;font-size:15px;line-height:1.6;font-weight:400;margin-top:24px;max-width:760px">We'll give you a straight recommendation for your car and budget — no upsell. The goal is the right film for you, not the most expensive one.</p>
    </div>
  </section>

  <FAQ items={faqs} eyebrow="FAQ" heading="Ceramic tint questions" dark={true} />

  <CTASection bg="#111114" heading="Want the coolest, clearest tint?" sub="Ask about our 3M ceramic film and get a free quote for your vehicle." />
</BaseLayout>
