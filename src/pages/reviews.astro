---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { routes, site } from '../data/site';

const title = 'Customer Reviews | Black Crown Tint Jacksonville';
const description =
  'Read what Northeast Florida drivers say about Black Crown Tint. Premium 3M window tinting, lifetime warranty and 100% mobile service across Jacksonville.';

const reviews = [
  { text: 'Add a real customer review here — pull your best from Google or Instagram.', name: 'Customer name', where: 'Jacksonville, FL', initial: 'C' },
  { text: 'Add a real customer review here — pull your best from Google or Instagram.', name: 'Customer name', where: 'Jacksonville Beach, FL', initial: 'M' },
  { text: 'Add a real customer review here — pull your best from Google or Instagram.', name: 'Customer name', where: 'Orange Park, FL', initial: 'J' },
  { text: 'Add a real customer review here — pull your best from Google or Instagram.', name: 'Customer name', where: 'St. Augustine, FL', initial: 'A' },
  { text: 'Add a real customer review here — pull your best from Google or Instagram.', name: 'Customer name', where: 'Nocatee, FL', initial: 'R' },
  { text: 'Add a real customer review here — pull your best from Google or Instagram.', name: 'Customer name', where: 'Fleming Island, FL', initial: 'L' },
];

const star = '<path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>';
// NOTE: AggregateRating schema intentionally omitted until real reviews exist.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Customer Reviews — Black Crown Tint',
  url: site.url + routes.reviews,
  description,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden">
    <div style="position:absolute;top:-200px;right:-160px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.3),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div style="position:relative;max-width:1180px;margin:0 auto;padding:60px 24px 56px;text-align:center">
      <div style="display:flex;justify-content:center"><Breadcrumb items={[{ label: 'Home', href: routes.home }, { label: 'Reviews' }]} /></div>
      <h1 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(34px,4.8vw,56px);line-height:1.04;letter-spacing:-0.01em;text-transform:uppercase;margin-bottom:18px">Customer Reviews</h1>
      <p style="font-size:18px;line-height:1.6;color:#A8A5AC;max-width:520px;margin:0 auto 32px;font-weight:400">Loved by drivers across Northeast Florida. Here's what people say about their Black Crown install.</p>
      <div style="display:inline-flex;align-items:center;gap:20px;border:1px solid rgba(255,255,255,0.12);border-radius:18px;padding:22px 30px;background:linear-gradient(180deg,#16161a,#101013)">
        <div style="text-align:center;padding-right:20px;border-right:1px solid rgba(255,255,255,.1)"><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:40px;color:#fff;line-height:1">5.0</div><div style="display:flex;gap:3px;margin-top:6px;justify-content:center">{[0,1,2,3,4].map(() => (<svg width="16" height="16" viewBox="0 0 24 24" fill="#C81878" set:html={star}></svg>))}</div></div>
        <div style="text-align:left"><div style="font-weight:600;font-size:15px;color:#fff">Rating shown is a placeholder</div><div style="font-size:13px;color:#71717A;margin-top:3px">Your live Google rating drops in here once your profile is active.</div></div>
      </div>
    </div>
  </section>

  <!-- GRID -->
  <section style="background:#F5F4F6;padding:80px 24px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-r-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
        {reviews.map((r) => (
          <div class="bc-tile bc-reveal" data-tilt data-reveal style="background:#fff;border:1px solid #E4E4E7;border-radius:18px;padding:30px 28px;display:flex;flex-direction:column">
            <div style="display:flex;gap:3px;margin-bottom:16px">
              {[0, 1, 2, 3, 4].map(() => (<svg width="17" height="17" viewBox="0 0 24 24" fill="#C81878" set:html={star}></svg>))}
            </div>
            <p style="color:#3F3F46;font-size:15px;line-height:1.65;font-weight:400;margin-bottom:22px;flex:1">{r.text}</p>
            <div style="display:flex;align-items:center;gap:12px">
              <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#C81878,#920A5A);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;color:#fff">{r.initial}</div>
              <div><div style="font-weight:600;font-size:14px;color:#0A0A0C">{r.name}</div><div style="font-size:12.5px;color:#71717A">{r.where}</div></div>
            </div>
          </div>
        ))}
      </div>
      <p style="text-align:center;color:#71717A;font-size:13px;margin-top:26px;font-weight:400">Reviews shown are placeholders — your real Google &amp; Instagram reviews go here.</p>
    </div>
  </section>

  <!-- LEAVE A REVIEW -->
  <section style="background:#0A0A0C;color:#fff;padding:84px 24px;position:relative;overflow:hidden">
    <div style="position:absolute;top:-140px;left:-120px;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.2),transparent 65%);filter:blur(12px)"></div>
    <div class="bc-reveal" data-reveal style="position:relative;max-width:780px;margin:0 auto;text-align:center">
      <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">LEAVE US A REVIEW</div>
      <h2 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(28px,4vw,42px);line-height:1.08;letter-spacing:-0.015em;margin-bottom:16px">Happy with your tint?</h2>
      <p style="color:#A8A5AC;font-size:17px;line-height:1.6;max-width:520px;margin:0 auto 30px;font-weight:400">Your review helps other Jacksonville drivers find us — and means the world to a growing local business. It only takes a minute.</p>
      <div class="bc-r-stack" style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a href={site.instagramHref} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:16px;padding:16px 30px;border-radius:10px;display:flex;align-items:center;gap:10px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>Tag us @blackcrowntint</a>
        <a href={routes.contact} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:16px;padding:16px 30px;border-radius:10px">We'll link Google here →</a>
      </div>
    </div>
  </section>

  <!-- CTA STRIP -->
  <section style="background:#111114;color:#fff;padding:62px 24px;border-top:1px solid rgba(255,255,255,.05)">
    <div class="bc-reveal bc-r-stack" data-reveal style="max-width:1180px;margin:0 auto;display:flex;gap:30px;align-items:center;justify-content:space-between;flex-wrap:wrap">
      <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(22px,2.6vw,28px);line-height:1.15;max-width:560px">Want a tint job worth reviewing? Get your free quote.</h2>
      <a href={routes.contact} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:15.5px;padding:15px 28px;border-radius:10px;flex:none">Get a free quote</a>
    </div>
  </section>
</BaseLayout>
