---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { routes, site } from '../data/site';

const title = 'How Much Does Window Tinting Cost? | Black Crown Tint';
const description =
  'What window tinting costs in Jacksonville, FL — by vehicle type and film (carbon vs ceramic), the 5 factors that move your price, and why cheap tint costs more.';

const vehicles = [
  { name: 'Coupe / Sedan', note: '2 doors + rear', range: '$', svg: '<path d="M5 13l1.5-4.5A2 2 0 0 1 8.4 7h7.2a2 2 0 0 1 1.9 1.5L19 13M5 13h14v4H5z"></path>' },
  { name: 'Full Sedan', note: '4 doors + rear', range: '$$', svg: '<path d="M3 13l1.5-4.5A2 2 0 0 1 6.4 7h11.2a2 2 0 0 1 1.9 1.5L21 13M3 13h18v4H3z"></path>' },
  { name: 'SUV / Truck', note: 'more glass', range: '$$$', svg: '<path d="M3 13l2-5.5A2 2 0 0 1 6.9 6h10.2a2 2 0 0 1 1.9 1.5L21 13M3 13h18v5H3z"></path>' },
  { name: 'Van / 3-row', note: 'most windows', range: '$$$$', svg: '<path d="M3 7h13l5 5v5H3zM3 12h18"></path>' },
];

const factors = [
  ['Number of windows', 'Two fronts cost far less than a full vehicle.'],
  ['Film tier', 'Carbon vs ceramic is the biggest single factor.'],
  ['Vehicle complexity', 'Curved rear glass and big SUVs take more time and film.'],
  ['Old tint removal', 'Stripping faded film adds labor before the new install.'],
  ['Warranty & quality', 'Real 3M film and a warranty cost a bit more — and save you later.'],
];

const faqs = [
  { q: "Why won't you just list exact prices?", a: 'Because honest pricing depends on your specific vehicle, window count and film choice. A flat number online is usually a bait price. We give you a real, no-pressure quote tailored to your car.' },
  { q: 'Is ceramic worth paying more for?', a: 'In Florida heat, often yes — ceramic rejects more heat, stays clearer and carries a lifetime warranty. If budget is tight, 3M carbon is a strong-value alternative.' },
  { q: 'Do you price-match cheap shops?', a: 'We compete on quality, not the lowest dyed-film price. We use real 3M film and back it with a warranty, which saves you the cost of re-doing cheap tint later.' },
  { q: 'Does removing old tint cost extra?', a: "Stripping faded or bubbling film adds some labor before we install the new film. We'll include it in your quote so there are no surprises." },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'How Much Does Window Tinting Cost?',
    description,
    author: { '@type': 'Organization', name: site.name },
    publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: site.url + '/brand/logo-lockup.png' } },
    mainEntityOfPage: site.url + routes.cost,
    dateModified: '2026-01-01',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden">
    <div style="position:absolute;top:-200px;right:-160px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.28),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div style="position:relative;max-width:820px;margin:0 auto;padding:56px 24px 52px;text-align:center">
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid rgba(200,24,120,0.4);border-radius:999px;padding:7px 15px;font-size:12px;font-weight:600;letter-spacing:0.05em;color:#fff;margin-bottom:22px;background:rgba(200,24,120,.1)"><span style="width:6px;height:6px;background:#C81878;border-radius:50%"></span>HONEST PRICING · 2026</div>
      <h1 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(32px,4.6vw,52px);line-height:1.06;letter-spacing:-0.01em;margin-bottom:20px">How Much Does Window<br>Tinting Cost?</h1>
      <p style="font-size:18px;line-height:1.6;color:#A8A5AC;max-width:620px;margin:0 auto;font-weight:400"><strong style="color:#fff;font-weight:600">Short answer:</strong> most full-vehicle tints land somewhere between an entry carbon job and a premium ceramic job. Your exact price depends on your vehicle, how many windows, and the film tier. Below is what moves the price — and why a free quote is the honest way to your real number.</p>
    </div>
  </section>

  <!-- COST BY VEHICLE -->
  <section style="background:#F5F4F6;padding:80px 24px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="max-width:600px;margin-bottom:42px"><div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">COST BY VEHICLE TYPE</div><h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-0.01em;color:#0A0A0C">More glass, more film, more cost</h2></div>
      <div class="bc-r-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px">
        {vehicles.map((v) => (
          <div class="bc-tile bc-reveal" data-tilt data-reveal style="background:#fff;border:1px solid #E4E4E7;border-radius:18px;padding:28px 24px">
            <div style="width:46px;height:46px;border-radius:12px;background:rgba(200,24,120,.1);display:flex;align-items:center;justify-content:center;margin-bottom:18px;color:#C81878"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={v.svg}></svg></div>
            <h3 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:17px;margin-bottom:6px;color:#0A0A0C">{v.name}</h3>
            <div style="font-size:13px;color:#71717A;margin-bottom:14px">{v.note}</div>
            <div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:15px;color:#0A0A0C">{v.range}</div>
            <div style="font-size:12px;color:#A8A5AC;margin-top:2px">full vehicle, carbon → ceramic</div>
          </div>
        ))}
      </div>
      <p class="bc-reveal" data-reveal style="color:#71717A;font-size:13px;margin-top:18px;line-height:1.5;font-weight:400">Ranges are illustrative — your exact price comes from a free quote.</p>
    </div>
  </section>

  <!-- COST BY FILM -->
  <section style="background:#0A0A0C;color:#fff;padding:84px 24px">
    <div style="max-width:980px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="text-align:center;max-width:600px;margin:0 auto 40px"><div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">COST BY FILM TYPE</div><h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-0.01em">What you pay for, by film</h2></div>
      <div class="bc-r-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px">
        <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:30px 26px;background:linear-gradient(180deg,#16161a,#101013)"><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:22px;color:#A8A5AC;margin-bottom:6px">Dyed</div><div style="font-size:13px;color:#71717A;margin-bottom:16px">entry level</div><p style="color:#A8A5AC;font-size:14px;line-height:1.6;font-weight:400">Cheapest up front, but fades and can turn purple. We don't recommend it — it costs more in re-dos.</p></div>
        <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:30px 26px;background:linear-gradient(180deg,#16161a,#101013)"><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:22px;color:#fff;margin-bottom:6px">Carbon</div><div style="font-size:13px;color:#71717A;margin-bottom:16px">smart value</div><p style="color:#A8A5AC;font-size:14px;line-height:1.6;font-weight:400">Mid-priced 3M film that blocks UV, won't fade, and looks great. A strong everyday choice, 5-year warranty.</p></div>
        <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid rgba(200,24,120,0.4);border-radius:18px;padding:30px 26px;background:linear-gradient(180deg,#1a1118,#101013)"><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:22px;color:#C81878;margin-bottom:6px">Ceramic</div><div style="font-size:13px;color:#71717A;margin-bottom:16px">premium</div><p style="color:#A8A5AC;font-size:14px;line-height:1.6;font-weight:400">Top heat rejection, max clarity, lifetime warranty. Costs more up front and lasts the longest.</p></div>
      </div>
    </div>
  </section>

  <!-- WHAT AFFECTS PRICE -->
  <section style="background:#F5F4F6;padding:84px 24px">
    <div class="bc-r-split" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:0.9fr 1.1fr;gap:52px;align-items:center">
      <div class="bc-reveal" data-reveal>
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">WHAT AFFECTS THE PRICE</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(26px,3.2vw,36px);line-height:1.1;color:#0A0A0C">Five things that move your quote</h2>
      </div>
      <div class="bc-reveal" data-reveal style="display:flex;flex-direction:column;gap:14px">
        {factors.map(([t, d], i) => (
          <div class="bc-tile" style="display:flex;gap:15px;align-items:center;background:#fff;border:1px solid #E4E4E7;border-radius:14px;padding:18px 20px"><div style="width:38px;height:38px;border-radius:10px;background:rgba(200,24,120,.1);display:flex;align-items:center;justify-content:center;flex:none;font-family:'Poppins';font-weight:800;color:#C81878">{i + 1}</div><div><div style="font-weight:600;font-size:15px;color:#0A0A0C">{t}</div><div style="color:#52525B;font-size:14px;line-height:1.5">{d}</div></div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CHEAP COSTS MORE -->
  <section style="background:#111114;color:#fff;padding:80px 24px;border-top:1px solid rgba(255,255,255,.05)">
    <div class="bc-reveal" data-reveal style="max-width:880px;margin:0 auto;text-align:center">
      <div style="width:54px;height:54px;border-radius:14px;background:rgba(200,24,120,.14);display:flex;align-items:center;justify-content:center;margin:0 auto 22px"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></div>
      <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(26px,3.4vw,38px);line-height:1.12;margin-bottom:16px">Why cheap tint costs more later</h2>
      <p style="color:#A8A5AC;font-size:17px;line-height:1.7;font-weight:400;max-width:680px;margin:0 auto">Bargain dyed film fades, bubbles and turns purple within a couple of Florida summers. Then you pay again — to strip the old film and re-tint. Quality 3M film with a warranty costs a little more up front and skips that whole cycle. The cheapest quote is rarely the cheapest in the end.</p>
    </div>
  </section>

  <FAQ items={faqs} eyebrow="FAQ" heading="Window tint cost questions" />

  <!-- CTA (custom: secondary links to Ceramic vs Carbon) -->
  <section style="background:#0A0A0C;color:#fff;padding:84px 24px;position:relative;overflow:hidden">
    <div style="position:absolute;bottom:-220px;left:-160px;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.24),transparent 62%);filter:blur(14px)"></div>
    <div class="bc-reveal" data-reveal style="position:relative;max-width:780px;margin:0 auto;text-align:center">
      <h2 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(28px,4vw,44px);line-height:1.08;letter-spacing:-0.015em;margin-bottom:18px">Get your exact price — free</h2>
      <p style="color:#A8A5AC;font-size:18px;line-height:1.6;max-width:540px;margin:0 auto 30px;font-weight:400">No guessing, no pressure. Tell us your vehicle and we'll send an honest quote.</p>
      <div class="bc-r-stack" style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a href={routes.contact} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:10px">Get a free quote</a>
        <a href={routes.ceramicVsCarbon} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:16px;padding:16px 32px;border-radius:10px">Ceramic vs carbon</a>
      </div>
    </div>
  </section>
</BaseLayout>
