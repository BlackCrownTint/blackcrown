---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { routes, site } from '../data/site';

const title = 'Florida Window Tint Laws 2026 | Legal VLT Limits';
const description =
  "Florida window tint laws for 2026: legal VLT limits for sedans, SUVs & vans, reflection rules, medical exemptions and penalties — explained in plain English.";

const scale = [
  { v: '5%', label: 'Limo — back glass only', bg: '#0A0A0C', color: '#71717A', border: '1px solid rgba(255,255,255,.1)', vColor: '#fff' },
  { v: '15%', label: 'FL legal — sedan rear & back sides', bg: '#262629', color: '#A8A5AC', border: 'none', vColor: '#fff' },
  { v: '28%', label: 'FL legal — front side windows', bg: '#52525B', color: '#fff', border: '1.5px solid #C81878', vColor: '#C81878', weight: 600 },
  { v: '50%', label: 'Light — heat & UV with little darkness', bg: '#A8A5AC', color: '#27272A', border: 'none', vColor: '#fff' },
  { v: '70%', label: 'Nearly clear — ceramic windshield film', bg: '#E4E4E7', color: '#3F3F46', border: 'none', vColor: '#fff' },
];

const colorRules = [
  'Florida does not ban specific tint colors, but red and amber are commonly avoided.',
  'Dual side mirrors are required if the rear window is tinted.',
  'Film makers must certify the tint they sell in Florida.',
  'A compliance sticker is not required between film and glass.',
];

const faqs = [
  { q: 'How dark can you legally tint in Florida?', a: 'On the front side windows you must keep at least 28% VLT. Sedans must keep 15% or more on the back side and rear windows, while SUVs and vans can go any darkness on the back glass. The windshield can only have a non-reflective strip above the AS-1 line.' },
  { q: 'Is 20% tint legal in Florida?', a: '20% is legal on the back side and rear windows of a sedan (the limit there is 15%), and on any rear window of an SUV or van. It is not legal on the front side windows, which must stay at 28% or lighter.' },
  { q: 'Can I get a ticket for illegal tint?', a: "Yes. Illegal tint is a noncriminal traffic infraction in Florida, typically issued as a 'fix-it' ticket with a fine around $100 for a first offense. You may be required to remove the film and re-tint to legal limits." },
  { q: 'Does Florida allow a medical tint exemption?', a: 'Yes. With a signed certificate from a licensed physician or optometrist — for a condition needing limited sun exposure — you can legally go darker than the standard limits. Keep the certificate in your vehicle.' },
  { q: 'Are there tint limits for homes and businesses?', a: "No. Florida's VLT darkness rules apply only to vehicles. Residential and commercial window film has no darkness restriction, so you can choose any level for heat, glare, privacy and UV protection." },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Florida Window Tint Laws (2026): Legal VLT Limits Explained',
    description,
    author: { '@type': 'Organization', name: site.name },
    publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: site.url + '/brand/logo-lockup.png' } },
    mainEntityOfPage: site.url + routes.floridaLaws,
    dateModified: '2026-01-01',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden">
    <div style="position:absolute;top:-200px;right:-160px;width:660px;height:660px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.3),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div class="bc-r-hero" style="position:relative;max-width:1180px;margin:0 auto;padding:60px 24px 64px;display:grid;grid-template-columns:1.15fr 0.85fr;gap:54px;align-items:center">
      <div>
        <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid rgba(200,24,120,0.45);border-radius:999px;padding:7px 15px;font-size:12px;font-weight:600;letter-spacing:0.05em;color:#fff;margin-bottom:24px;background:rgba(200,24,120,.1)"><span style="width:6px;height:6px;background:#C81878;border-radius:50%;animation:bcPulse 2s ease-in-out infinite"></span>UPDATED FOR 2026</div>
        <h1 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(36px,5.2vw,60px);line-height:1.02;letter-spacing:-0.01em;margin-bottom:22px">Florida Window<br>Tint Laws <span style="color:#C81878">(2026)</span></h1>
        <p style="font-size:18px;line-height:1.6;color:#A8A5AC;max-width:520px;font-weight:400">Know exactly how dark you can legally go before you tint. Here are Florida's current VLT limits, reflection rules, medical exemptions and penalties — explained in plain English.</p>
        <div style="display:flex;flex-wrap:wrap;gap:13px;margin-top:32px">
          <a href="#limits" data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:15px;padding:15px 28px;border-radius:10px">See the legal limits</a>
          <a href={routes.contact} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:15px;padding:15px 28px;border-radius:10px">Get a free quote</a>
        </div>
      </div>
      <div style="position:relative;aspect-ratio:4/5;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);box-shadow:0 40px 80px -30px rgba(0,0,0,.8);background:linear-gradient(170deg,#1a1620,#2a1424)">
        <div style="position:absolute;inset:0;background:radial-gradient(100% 80% at 70% 18%,rgba(200,24,120,.3),transparent 58%)"></div>
        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;gap:16px">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3z"></path><path d="m9 12 2 2 4-4"></path></svg>
          <div style="text-align:center"><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:30px;color:#fff">100% Legal</div><div style="color:#A8A5AC;font-size:13px;margin-top:4px">installs, every time</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SHORT ANSWER -->
  <section style="background:#111114;border-top:1px solid rgba(200,24,120,0.2);border-bottom:1px solid rgba(255,255,255,0.05)">
    <div class="bc-r-stack" style="max-width:1180px;margin:0 auto;padding:34px 24px;display:flex;gap:22px;align-items:flex-start">
      <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.14em;color:#C81878;flex:none;padding-top:3px">THE SHORT ANSWER</div>
      <p style="color:#D4D4D8;font-size:17px;line-height:1.65;max-width:880px;font-weight:400">In Florida, your <strong style="color:#fff;font-weight:600">front side windows must let in more than 28% of light (VLT)</strong>. On sedans, back side and rear windows must allow <strong style="color:#fff;font-weight:600">more than 15%</strong>. SUVs and vans can have <strong style="color:#fff;font-weight:600">any darkness</strong> on the back glass. Windshields may only be tinted with a non-reflective strip above the AS-1 line.</p>
    </div>
  </section>

  <!-- LIMITS TABLE -->
  <section id="limits" style="background:#F5F4F6;padding:88px 24px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="max-width:640px;margin-bottom:42px">
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">LEGAL VLT LIMITS</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(30px,3.8vw,44px);line-height:1.08;letter-spacing:-0.01em;margin-bottom:14px;color:#0A0A0C">How dark can you legally tint in Florida?</h2>
        <p style="color:#52525B;font-size:16.5px;line-height:1.6;font-weight:400">VLT means <strong style="font-weight:600">Visible Light Transmission</strong> — the percentage of light a window lets through. A higher % is lighter; a lower % is darker. Limits depend on your vehicle type.</p>
      </div>
      <div class="bc-r-2" style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
        <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid #E4E4E7;border-radius:18px;overflow:hidden;background:#fff">
          <div style="background:#0A0A0C;color:#fff;padding:20px 24px;display:flex;align-items:center;justify-content:space-between"><span style="font-family:'Poppins',sans-serif;font-weight:700;font-size:19px;display:flex;align-items:center;gap:10px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l1.5-4.5A2 2 0 0 1 8.4 7h7.2a2 2 0 0 1 1.9 1.5L19 13M5 13h14v4H5z"></path><circle cx="7.5" cy="15.5" r=".6"></circle><circle cx="16.5" cy="15.5" r=".6"></circle></svg>Sedans</span><span style="font-size:12px;color:#C81878;font-weight:600;letter-spacing:0.04em">PASSENGER CARS</span></div>
          <div style="padding:8px 24px 20px">
            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid #F4F4F5"><span style="color:#3F3F46;font-size:15px">Windshield</span><span style="font-family:'Poppins',sans-serif;font-weight:600;font-size:14px;color:#0A0A0C;text-align:right">Non-reflective<br><span style="font-size:12px;color:#71717A;font-weight:500">above AS-1 line</span></span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid #F4F4F5"><span style="color:#3F3F46;font-size:15px">Front side windows</span><span style="font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;color:#C81878">28%</span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid #F4F4F5"><span style="color:#3F3F46;font-size:15px">Back side windows</span><span style="font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;color:#0A0A0C">15%</span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0"><span style="color:#3F3F46;font-size:15px">Rear window</span><span style="font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;color:#0A0A0C">15%</span></div>
          </div>
        </div>
        <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid #E4E4E7;border-radius:18px;overflow:hidden;background:#fff">
          <div style="background:#0A0A0C;color:#fff;padding:20px 24px;display:flex;align-items:center;justify-content:space-between"><span style="font-family:'Poppins',sans-serif;font-weight:700;font-size:19px;display:flex;align-items:center;gap:10px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l2-5.5A2 2 0 0 1 6.9 6h10.2a2 2 0 0 1 1.9 1.5L21 13M3 13h18v5H3z"></path><circle cx="6.5" cy="15.5" r=".6"></circle><circle cx="17.5" cy="15.5" r=".6"></circle></svg>SUVs &amp; Vans</span><span style="font-size:12px;color:#C81878;font-weight:600;letter-spacing:0.04em">MULTIPURPOSE</span></div>
          <div style="padding:8px 24px 20px">
            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid #F4F4F5"><span style="color:#3F3F46;font-size:15px">Windshield</span><span style="font-family:'Poppins',sans-serif;font-weight:600;font-size:14px;color:#0A0A0C;text-align:right">Non-reflective<br><span style="font-size:12px;color:#71717A;font-weight:500">above AS-1 line</span></span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid #F4F4F5"><span style="color:#3F3F46;font-size:15px">Front side windows</span><span style="font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;color:#C81878">28%</span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid #F4F4F5"><span style="color:#3F3F46;font-size:15px">Back side windows</span><span style="font-family:'Poppins',sans-serif;font-weight:700;font-size:15px;color:#0A0A0C">Any darkness</span></div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0"><span style="color:#3F3F46;font-size:15px">Rear window</span><span style="font-family:'Poppins',sans-serif;font-weight:700;font-size:15px;color:#0A0A0C">Any darkness</span></div>
          </div>
        </div>
      </div>
      <p class="bc-reveal" data-reveal style="color:#71717A;font-size:13px;margin-top:18px;line-height:1.5;font-weight:400">The AS-1 line is the manufacturer's mark near the top of your windshield. Tint above it must be non-reflective. Percentages shown are the <em>minimum</em> light that must pass through — you cannot go darker than these.</p>
    </div>
  </section>

  <!-- VLT EXPLAINER -->
  <section style="background:#0A0A0C;color:#fff;padding:88px 24px">
    <div class="bc-r-split" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:0.9fr 1.1fr;gap:54px;align-items:center">
      <div class="bc-reveal" data-reveal>
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">UNDERSTANDING VLT</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-0.01em;margin-bottom:18px">What does VLT % actually mean?</h2>
        <p style="color:#A8A5AC;font-size:16.5px;line-height:1.7;margin-bottom:14px;font-weight:400">VLT is the share of visible light that passes through the glass and film combined. <strong style="color:#fff;font-weight:600">5% is nearly black; 70% is barely tinted.</strong> When Florida says 28%, it means at least 28% of light must get through.</p>
        <p style="color:#A8A5AC;font-size:16.5px;line-height:1.7;font-weight:400">A professional shop measures the result with a tint meter — the same tool law enforcement uses.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:12px">
        {scale.map((s) => (
          <div class="bc-reveal" data-reveal style="display:flex;align-items:center;gap:16px"><div style={`flex:none;width:60px;font-family:'Poppins',sans-serif;font-weight:700;font-size:15px;text-align:right;color:${s.vColor}`}>{s.v}</div><div style={`height:46px;border-radius:10px;flex:1;background:${s.bg};border:${s.border};display:flex;align-items:center;padding:0 16px;color:${s.color};font-size:13px;font-weight:${s.weight ?? 500}`}>{s.label}</div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- REFLECTION & COLOR -->
  <section style="background:#F5F4F6;padding:88px 24px">
    <div class="bc-r-2" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:24px">
      <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid #E4E4E7;border-radius:18px;padding:36px 32px;background:#fff">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(200,24,120,.1);display:flex;align-items:center;justify-content:center;margin-bottom:20px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path><circle cx="12" cy="12" r="3"></circle></svg></div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:23px;margin-bottom:12px;color:#0A0A0C">Reflection limits</h2>
        <p style="color:#52525B;font-size:15.5px;line-height:1.65;margin-bottom:16px;font-weight:400">Tint can be reflective or mirrored, but only up to a point. Florida caps how much light your film may bounce back.</p>
        <div style="display:flex;justify-content:space-between;padding:12px 0;border-top:1px solid #F4F4F5"><span style="color:#3F3F46;font-size:15px">Front side windows</span><span style="font-family:'Poppins',sans-serif;font-weight:700;color:#0A0A0C">≤ 25% reflective</span></div>
        <div style="display:flex;justify-content:space-between;padding:12px 0;border-top:1px solid #F4F4F5"><span style="color:#3F3F46;font-size:15px">Back side windows</span><span style="font-family:'Poppins',sans-serif;font-weight:700;color:#0A0A0C">≤ 35% reflective</span></div>
      </div>
      <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid #E4E4E7;border-radius:18px;padding:36px 32px;background:#fff">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(200,24,120,.1);display:flex;align-items:center;justify-content:center;margin-bottom:20px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="10.5" r="2.5"></circle><circle cx="8.5" cy="7.5" r="2.5"></circle><circle cx="6.5" cy="12.5" r="2.5"></circle><path d="M12 2a10 10 0 1 0 0 20 2.5 2.5 0 0 0 2-4 2.5 2.5 0 0 1 2-4h2a4 4 0 0 0 4-4 10 10 0 0 0-10-8z"></path></svg></div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:23px;margin-bottom:12px;color:#0A0A0C">Color &amp; other rules</h2>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:13px">
          {colorRules.map((r) => (
            <li style="display:flex;gap:11px;color:#52525B;font-size:15.5px;line-height:1.55;font-weight:400"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>{r}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- MEDICAL + PENALTIES -->
  <section style="background:#0A0A0C;color:#fff;padding:88px 24px">
    <div class="bc-r-2" style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:24px">
      <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:38px 34px;background:linear-gradient(180deg,#16161a,#101013)">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(200,24,120,.14);display:flex;align-items:center;justify-content:center;margin-bottom:18px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v8M8 12h8"></path><rect x="3" y="3" width="18" height="18" rx="3"></rect></svg></div>
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:12.5px;letter-spacing:0.14em;color:#C81878;margin-bottom:12px">MEDICAL EXEMPTIONS</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:26px;margin-bottom:16px;line-height:1.15">Need darker tint for a medical reason?</h2>
        <p style="color:#A8A5AC;font-size:16px;line-height:1.7;font-weight:400">Florida allows a medical exemption for people with conditions that require limited sun exposure — such as lupus, melanoma or light sensitivity. You'll need a signed certificate from a licensed physician or optometrist, kept in the vehicle. The exemption lets you go darker than the standard limits.</p>
      </div>
      <div class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid rgba(200,24,120,0.4);border-radius:18px;padding:38px 34px;background:linear-gradient(180deg,#1a1118,#101013)">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(200,24,120,.14);display:flex;align-items:center;justify-content:center;margin-bottom:18px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></div>
        <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:12.5px;letter-spacing:0.14em;color:#C81878;margin-bottom:12px">PENALTIES</div>
        <h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:26px;margin-bottom:16px;line-height:1.15">What happens if your tint is illegal?</h2>
        <p style="color:#A8A5AC;font-size:16px;line-height:1.7;margin-bottom:18px;font-weight:400">Illegal tint is a noncriminal traffic infraction in Florida — usually a "fix-it" ticket. You may be required to remove the film and re-tint to legal limits.</p>
        <div style="display:flex;gap:24px">
          <div><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:30px;color:#C81878">~$100</div><div style="font-size:13px;color:#71717A;margin-top:4px;font-weight:400">typical first-offense fine</div></div>
          <div style="width:1px;background:rgba(255,255,255,0.1)"></div>
          <div><div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:30px;color:#fff">Repeat</div><div style="font-size:13px;color:#71717A;margin-top:4px;font-weight:400">higher fines &amp; removal</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- RES/COMM -->
  <section style="background:#111114;color:#fff;padding:64px 24px;border-top:1px solid rgba(255,255,255,.05)">
    <div class="bc-reveal bc-r-stack" data-reveal style="max-width:1180px;margin:0 auto;display:flex;gap:40px;align-items:center;justify-content:space-between;flex-wrap:wrap">
      <div style="max-width:600px">
