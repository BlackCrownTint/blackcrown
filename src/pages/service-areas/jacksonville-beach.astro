---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTASection from '../../components/CTASection.astro';
import { routes, site } from '../../data/site';

const title = 'Window Tinting Jacksonville Beach | Black Crown Tint';
const description =
  'Mobile window tinting in Jacksonville Beach, FL. Premium 3M ceramic film beats the coastal sun, glare and humidity — installed in your driveway. Free quote.';

const services = [
  { href: routes.auto, t: 'Auto tint', d: 'Heat, UV and glare control for your car, truck or SUV.', svg: '<path d="M5 13l1.5-4.5A2 2 0 0 1 8.4 7h7.2a2 2 0 0 1 1.9 1.5L19 13M5 13h14v4H5z"></path><circle cx="7.5" cy="15.5" r=".6"></circle><circle cx="16.5" cy="15.5" r=".6"></circle>' },
  { href: routes.residential, t: 'Home tint', d: 'Cooler rooms and faded-proof interiors for beach homes.', svg: '<path d="M3 11l9-7 9 7"></path><path d="M5 10v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9"></path><path d="M9 20v-6h6v6"></path>' },
  { href: routes.commercial, t: 'Commercial', d: 'Storefronts and offices along the Beaches.', svg: '<rect x="4" y="3" width="16" height="18" rx="1.5"></rect><path d="M8 7h.01M12 7h.01M16 7h.01M8 11h.01M12 11h.01M16 11h.01M10 21v-4h4v4"></path>' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name + ' — Jacksonville Beach',
  url: site.url + routes.serviceAreas + 'jacksonville-beach/',
  telephone: '+19048930927',
  image: site.url + '/brand/logo-lockup.png',
  areaServed: { '@type': 'City', name: 'Jacksonville Beach', addressRegion: 'FL' },
  address: { '@type': 'PostalAddress', addressLocality: 'Jacksonville Beach', addressRegion: 'FL', addressCountry: 'US' },
  description,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- HERO -->
  <section style="position:relative;background:#0A0A0C;color:#fff;overflow:hidden">
    <div style="position:absolute;top:-200px;right:-160px;width:640px;height:640px;border-radius:50%;background:radial-gradient(circle,rgba(200,24,120,0.3),transparent 62%);filter:blur(20px);pointer-events:none"></div>
    <div class="bc-r-hero" style="position:relative;max-width:1180px;margin:0 auto;padding:60px 24px 64px;display:grid;grid-template-columns:1.05fr 0.95fr;gap:54px;align-items:center">
      <div>
        <Breadcrumb items={[{ label: 'Home', href: routes.home }, { label: 'Areas', href: routes.serviceAreas }, { label: 'Jacksonville Beach' }]} />
        <div style="display:inline-flex;align-items:center;gap:8px;font-size:13px;color:#C81878;font-weight:600;margin-bottom:18px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>Jacksonville Beach, FL</div>
        <h1 style="font-family:'Poppins',sans-serif;font-weight:800;font-size:clamp(34px,4.6vw,54px);line-height:1.05;letter-spacing:-0.01em;text-transform:uppercase;margin-bottom:22px">Window Tinting in<br>Jacksonville Beach</h1>
        <p style="font-size:18px;line-height:1.6;color:#A8A5AC;max-width:500px;font-weight:400">Beat the coastal sun, salt glare and humidity with premium 3M ceramic film — installed right in your Jax Beach driveway. We come to you.</p>
        <div style="display:flex;flex-wrap:wrap;gap:13px;margin-top:32px">
          <a href={routes.contact} data-magnetic class="bc-cta-btn" style="background:#C81878;color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:15.5px;padding:16px 30px;border-radius:10px;display:flex;align-items:center;gap:10px">Get a free quote <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
          <a href={site.phoneHref} class="bc-ghost" style="border:1px solid rgba(255,255,255,0.22);color:#fff;font-weight:600;font-size:15.5px;padding:16px 28px;border-radius:10px;display:flex;align-items:center;gap:10px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>{site.phone}</a>
        </div>
      </div>
      <div style="position:relative;aspect-ratio:5/4;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);box-shadow:0 40px 80px -30px rgba(0,0,0,.8);background:repeating-linear-gradient(45deg,#161619,#161619 11px,#1d1d20 11px,#1d1d20 22px);display:flex;align-items:flex-end;justify-content:center;animation:bcFloat 7s ease-in-out infinite">
        <div style="position:absolute;inset:0;background:radial-gradient(110% 90% at 75% 12%,rgba(200,24,120,.2),transparent 58%)"></div>
        <div style="position:relative;font-family:'Poppins',sans-serif;font-size:13px;letter-spacing:0.04em;color:#C81878;background:rgba(10,10,12,0.7);border:1px dashed rgba(200,24,120,0.5);padding:8px 14px;border-radius:6px;margin-bottom:22px;font-weight:600">IMG · Jax Beach install</div>
      </div>
    </div>
  </section>

  <!-- LOCAL WHY -->
  <section style="background:#F5F4F6;padding:88px 24px">
    <div style="max-width:820px;margin:0 auto">
      <div class="bc-reveal" data-reveal><div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">WHY TINT AT THE BEACH</div><h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.6vw,40px);line-height:1.1;letter-spacing:-0.01em;color:#0A0A0C">Built for the coastal climate</h2></div>
      <div class="bc-reveal" data-reveal style="display:flex;flex-direction:column;gap:18px;margin-top:22px">
        <p style="color:#3F3F46;font-size:17px;line-height:1.75;font-weight:400">Life in Jacksonville Beach means long, bright days and a car that bakes in the oceanfront sun. Between the drive down Beach Boulevard, parking near the pier and the constant glare off the water and white sand, your interior takes a beating from heat and UV all year. Quality window tint is one of the easiest ways to keep your car comfortable and protect what's inside.</p>
        <p style="color:#3F3F46;font-size:17px;line-height:1.75;font-weight:400">Our 3M ceramic film rejects the infrared heat you actually feel, so your A/C doesn't have to fight the afternoon sun every time you leave the beach. It blocks 99% of UV to stop your dash, leather and trim from fading and cracking — a real problem this close to the coast — and it cuts the harsh glare that bounces off the Atlantic and the sand on your morning commute.</p>
        <p style="color:#3F3F46;font-size:17px;line-height:1.75;font-weight:400">Because we're fully mobile, you never have to drive anywhere — we bring the shop to your driveway, office or beachside rental anywhere in Jacksonville Beach and the surrounding coast. From the homes near South Beach Park to the condos along 1st Street and the shops in the Beaches Town Center, we'll meet you where it's convenient and install on your schedule.</p>
        <p style="color:#3F3F46;font-size:17px;line-height:1.75;font-weight:400">Every install is done to Florida's legal tint limits and backed by our warranty — lifetime on 3M ceramic, five years on carbon. Whether it's a daily driver, a weekend convertible or the family SUV, you get the same precise, exotic-grade finish we honed tinting high-end cars in Dubai, now right here at the beach.</p>
      </div>
    </div>
  </section>

  <!-- SERVICES IN ZONE -->
  <section style="background:#0A0A0C;color:#fff;padding:84px 24px">
    <div style="max-width:1180px;margin:0 auto">
      <div class="bc-reveal" data-reveal style="max-width:600px;margin-bottom:46px"><div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.16em;color:#C81878;margin-bottom:14px">SERVICES IN JAX BEACH</div><h2 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:clamp(28px,3.5vw,40px);line-height:1.1;letter-spacing:-0.01em">What we install locally</h2></div>
      <div class="bc-r-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px">
        {services.map((s) => (
          <a href={s.href} class="bc-tile bc-reveal" data-tilt data-reveal style="border:1px solid rgba(255,255,255,0.1);border-radius:18px;padding:32px 28px;background:linear-gradient(180deg,#16161a,#101013);display:block"><div style="width:48px;height:48px;border-radius:13px;background:rgba(200,24,120,.14);display:flex;align-items:center;justify-content:center;margin-bottom:18px"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C81878" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg}></svg></div><h3 style="font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;margin-bottom:9px">{s.t}</h3><p style="color:#A8A5AC;font-size:14px;line-height:1.6;font-weight:400">{s.d} <span style="color:#C81878">Learn more →</span></p></a>
        ))}
      </div>
    </div>
  </section>

  <CTASection bg="#111114" heading="Tint your ride in Jax Beach" sub="We'll come to you anywhere in Jacksonville Beach. Get a free quote today." />
</BaseLayout>
