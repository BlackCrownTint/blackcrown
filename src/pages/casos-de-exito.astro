---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../data/site';
const projects = [
  {id:'home',category:'RESIDENTIAL',title:'A clearer view of home.',subtitle:'Window film for a home with a deck-facing glass wall.',detail:'Large panes, glass doors and upper windows make this home a useful look at residential film in a real setting. Explore the exterior glass, interior views and door details.',href:routes.residential,tool:`${routes.residential}#savings-explorer`,toolLabel:'Explore home savings',photos:[{id:7,alt:'Exterior residential glass wall facing a deck'},{id:8,alt:'Close view of the large residential windows'},{id:9,alt:'View through residential glass toward the coast'},{id:10,alt:'Interior view of the deck-facing windows'},{id:13,alt:'Residential glass doors opening to a deck'}]},
  {id:'pickup',category:'AUTOMOTIVE',title:'A pickup, from every angle.',subtitle:'A gray pickup with tinted side glass.',detail:'The side and front-angle photos show the glass in natural daylight. A close-up from the installation shows the door protection used while working on the vehicle.',href:routes.auto,tool:`${routes.auto}#tint-explorer`,toolLabel:'Explore auto tint',photos:[{id:15,alt:'Side view of a gray pickup with tinted windows'},{id:14,alt:'Front side view of the gray pickup'},{id:19,alt:'Protective cover on a vehicle door during installation'}]},
  {id:'jeep',category:'AUTOMOTIVE',title:'The details around the glass.',subtitle:'Side and rear window views of a green Jeep.',detail:'Two perspectives show the side glass and the rear window, keeping the focus on the finished vehicle and the details around its windows.',href:routes.auto,tool:`${routes.auto}#tint-explorer`,toolLabel:'Explore auto tint',photos:[{id:2,alt:'Side view of a green Jeep with tinted windows'},{id:3,alt:'Rear glass and side window details of the Jeep'}]},
];
const src = (id:number) => `/images/project-${String(id).padStart(2,'0')}.webp`;
---
<BaseLayout title="Window Tint Success Stories | Black Crown Tint Jacksonville" description="Explore real Black Crown Tint projects: residential glass, a gray pickup and a green Jeep. View project photos and plan your automotive or home window film.">
<section class="stories-hero stories-shell">
  <div class="stories-copy"><p class="stories-kicker">BLACK CROWN / SUCCESS STORIES</p><h1>Our work.<br/><em>Your next idea.</em></h1><p class="stories-lead">Real glass. Real settings. Take a closer look at our automotive and residential projects.</p><a class="stories-primary" href="#projects">Explore the projects <span aria-hidden="true">&darr;</span></a><div class="stories-proof"><span><strong>03</strong>Project stories</span><span><strong>10</strong>Real photos</span></div></div>
  <figure class="stories-feature"><img src={src(7)} width="768" height="1024" alt="Real Black Crown residential project with large deck-facing windows" loading="eager" fetchpriority="high"/><figcaption><span>FEATURED PROJECT</span>Residential window film <a href="#home" aria-label="View the residential project">&nearr;</a></figcaption></figure>
</section>
<section id="projects" class="stories-shell stories-index" aria-label="Choose a project"><p>FIND YOUR INSPIRATION</p><div>{projects.map(p=><a href={`#${p.id}`}>{p.id==='home'?'Home windows':p.id==='pickup'?'Pickup tint':'Jeep tint'} <span aria-hidden="true">&nearr;</span></a>)}</div></section>
{projects.map((project,i)=><section class="stories-case stories-shell" id={project.id} aria-labelledby={`${project.id}-title`}>
  <div class="stories-media" data-project-gallery><figure class="stories-main-photo"><img src={src(project.photos[0].id)} width="768" height="1024" alt={project.photos[0].alt} loading="lazy" decoding="async"/><figcaption aria-live="polite">{project.photos[0].alt}</figcaption></figure><div class="stories-thumbs" aria-label={`${project.category.toLowerCase()} project photos`}>{project.photos.map((photo,j)=><button type="button" aria-label={`View photo: ${photo.alt}`} aria-pressed={j===0?'true':'false'} data-src={src(photo.id)} data-alt={photo.alt}><img src={src(photo.id)} alt="" width="768" height="1024" loading="lazy" decoding="async"/></button>)}</div></div>
  <div class="stories-case-copy"><p class="stories-kicker">0{i+1} / {project.category}</p><h2 id={`${project.id}-title`}>{project.title}</h2><p class="stories-subtitle">{project.subtitle}</p><p class="stories-description">{project.detail}</p><div class="stories-details"><div><span>PROJECT TYPE</span><strong>{project.id==='home'?'Home window film':'Vehicle window tint'}</strong></div><div><span>IN THE PHOTOS</span><strong>{project.id==='home'?'Exterior, interior & doors':project.id==='pickup'?'Vehicle views & installation':'Side & rear glass'}</strong></div></div><a class="stories-primary" href={routes.contact}>Plan a project like this <span aria-hidden="true">&rarr;</span></a><a class="stories-text-link" href={project.tool}>{project.toolLabel} &rarr;</a></div>
</section>)}
<section class="stories-next stories-shell"><div><p class="stories-kicker">LET'S TALK ABOUT YOUR WINDOWS</p><h2>What would you<br/>like to tint?</h2><p>Tell us about your vehicle or space. We'll help you compare film options and get a quote for your project.</p></div><div class="stories-next-links"><a href={routes.contact}>Get a free quote <span>&nearr;</span></a><a href={routes.auto}>Auto window tinting <span>&rarr;</span></a><a href={routes.residential}>Residential window film <span>&rarr;</span></a></div></section>
</BaseLayout>
<script>
 document.querySelectorAll<HTMLElement>('[data-project-gallery]').forEach(gallery=>{
  const image=gallery.querySelector<HTMLImageElement>('.stories-main-photo img');
  const caption=gallery.querySelector('figcaption');
  gallery.querySelectorAll<HTMLButtonElement>('button').forEach(button=>button.addEventListener('click',()=>{
   if(!image||!button.dataset.src)return;
   image.src=button.dataset.src;image.alt=button.dataset.alt||'';
   if(caption)caption.textContent=image.alt;
   gallery.querySelectorAll('button').forEach(other=>other.setAttribute('aria-pressed',String(other===button)));
  }));
 });
</script>
<style>
.stories-hero>*,.stories-case>*,.stories-next>*{min-width:0}.stories-shell{max-width:1180px;margin:auto;padding-left:28px;padding-right:28px;color:#fff}.stories-kicker{font-size:11px;font-weight:700;letter-spacing:.16em;color:#ffb5dc}.stories-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;align-items:center;padding-top:64px;padding-bottom:64px}.stories-hero h1{font-size:clamp(48px,6.3vw,80px);font-weight:800;line-height:1.06;letter-spacing:-.05em;margin:24px 0}.stories-hero h1 em{font-family:'Playfair Display',serif;font-weight:500;color:#ffb5dc}.stories-lead{max-width:390px;font-size:18px;line-height:1.75;color:#bdb9c4;margin-bottom:30px}.stories-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;background:#c81878;color:white;padding:16px 22px;border-radius:10px;min-height:52px;font-weight:700;font-size:14px}.stories-primary:hover{background:#aa1266}.stories-proof{display:flex;gap:40px;border-top:1px solid #302b33;margin-top:38px;padding-top:24px}.stories-proof span{display:flex;flex-direction:column;gap:5px;font-size:12px;color:#bdb9c4}.stories-proof strong{font-size:26px;color:#fff;font-weight:600}.stories-feature{position:relative;margin:0;border-radius:24px;overflow:hidden}.stories-feature>img{width:100%;height:510px;object-fit:cover;display:block}.stories-feature figcaption{position:absolute;bottom:0;left:0;right:0;padding:50px 24px 24px;background:linear-gradient(transparent,#08080aeb);font-size:20px;font-weight:600}.stories-feature figcaption>span{display:block;font-size:10px;letter-spacing:.16em;color:#ffb5dc;margin-bottom:8px}.stories-feature figcaption>a{position:absolute;right:24px;bottom:24px;display:grid;place-items:center;width:44px;height:44px;border:1px solid #ffffff66;border-radius:50%}.stories-index{border-top:1px solid #302b33;border-bottom:1px solid #302b33;padding-top:25px;padding-bottom:25px;display:flex;align-items:center;justify-content:space-between;gap:24px;scroll-margin-top:115px}.stories-index>p{font-size:10px;letter-spacing:.14em;color:#aaa4b1}.stories-index>div{display:flex;gap:12px;flex-wrap:wrap}.stories-index a{padding:12px 18px;border:1px solid #39313b;border-radius:999px;font-size:13px;display:flex;gap:24px;align-items:center;min-height:44px}.stories-index a:hover{border-color:#ffb5dc;color:#ffb5dc}.stories-case{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;align-items:center;padding-top:76px;padding-bottom:76px;border-bottom:1px solid #302b33;scroll-margin-top:85px}.stories-main-photo{margin:0;border-radius:18px;overflow:hidden;background:#17141b}.stories-main-photo>img{display:block;width:100%;height:510px;object-fit:contain}.stories-main-photo figcaption{padding:14px 18px;font-size:12px;color:#bbb5c2;min-height:46px;line-height:1.5}.stories-thumbs{display:flex;gap:10px;margin-top:14px}.stories-thumbs button{flex:1;min-width:0;max-width:68px;width:68px;height:80px;padding:3px;border:2px solid transparent;border-radius:10px;background:#242028;cursor:pointer;overflow:hidden}.stories-thumbs button[aria-pressed=true]{border-color:#ffb5dc}.stories-thumbs img{width:100%;height:100%;object-fit:cover;border-radius:5px}.stories-case h2{font-size:clamp(32px,4vw,46px);line-height:1.15;letter-spacing:-.035em;margin:22px 0}.stories-subtitle{font-size:18px;line-height:1.6;color:#ece9ee}.stories-description{font-size:14px;line-height:1.85;color:#bdb9c4;margin:20px 0 28px}.stories-details{border-top:1px solid #302b33;padding-top:22px;margin-bottom:30px;display:grid;grid-template-columns:1fr 1fr;gap:20px}.stories-details span{display:block;color:#aaa4b1;font-size:9px;letter-spacing:.12em;margin-bottom:9px}.stories-details strong{font-size:12px;font-weight:500;line-height:1.6}.stories-text-link{display:block;color:#ffb5dc;margin-top:18px;font-size:13px;padding:6px 0}.stories-next{margin-top:60px;margin-bottom:70px;display:grid;grid-template-columns:1.2fr 1fr;gap:80px;padding-top:50px;padding-bottom:50px;border-radius:22px;background:radial-gradient(at 0% 100%,#3d152b,#17131b 65%)}.stories-next h2{font-size:clamp(34px,4vw,48px);line-height:1.15;margin:18px 0}.stories-next p:last-child{font-size:14px;color:#bdb9c4;line-height:1.8;max-width:430px}.stories-next-links{align-self:center}.stories-next-links>a{display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid #443544;font-size:14px;gap:20px}.stories-next-links>a:first-child{color:#ffb5dc;font-weight:700;font-size:18px}.stories-shell a:focus-visible,.stories-shell button:focus-visible{outline:2px solid #ffb5dc;outline-offset:5px}
@media(max-width:850px){.stories-hero,.stories-case{gap:32px}.stories-hero h1{font-size:54px}.stories-case h2{font-size:34px}.stories-next{gap:32px}.stories-feature>img{height:430px}}
@media(max-width:650px){.stories-hero,.stories-case,.stories-next{grid-template-columns:1fr;gap:30px}.stories-hero{padding-top:40px;padding-bottom:40px}.stories-hero h1{font-size:50px}.stories-feature>img{height:420px}.stories-index{align-items:flex-start;flex-direction:column}.stories-index>div{gap:8px}.stories-index a{font-size:12px;padding:10px 14px;gap:12px}.stories-case{padding-top:48px;padding-bottom:48px}.stories-case-copy{order:-1}.stories-main-photo>img{height:auto;max-height:560px}.stories-next{margin:40px 20px;padding:30px 24px}.stories-proof{margin-top:28px}.stories-feature figcaption{font-size:18px}}
</style>
