---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes, site } from '../data/site';
const projects = [
  { title: 'Jeep window tint', summary: 'A green Jeep with film on the side and rear glass. These photos show the vehicle from the side and the rear window details.', href: routes.auto, photos: [ {id:2,alt:'Side view of a green Jeep with tinted windows'}, {id:3,alt:'Rear window and side glass on the green Jeep'} ] },
  { title: 'Residential window film', summary: 'A home with large windows and glass doors facing a deck. Exterior and interior photos show the glass and the view through it.', href: routes.residential, photos: [ {id:7,alt:'Large residential windows facing an outdoor deck'}, {id:8,alt:'Close view of the residential window installation'}, {id:9,alt:'Coastal view through residential glass'}, {id:10,alt:'Interior view of the large residential windows'}, {id:13,alt:'Glass doors opening onto the residential deck'} ] },
  { title: 'Pickup window tint', summary: 'A gray pickup photographed from several angles, plus a close view of door protection during installation.', href: routes.auto, photos: [ {id:14,alt:'Gray pickup with tinted windows, viewed from the front side'}, {id:15,alt:'Side view of the gray pickup and its tinted windows'}, {id:19,alt:'Door protection and tools during window film installation'} ] },
];
---
<BaseLayout title="Window Tint Success Stories | Black Crown Tint Jacksonville" description="See real Black Crown Tint automotive and residential window film projects, including Jeep and pickup installations and home windows.">
  <section class="project-intro">
    <p class="project-eyebrow">SUCCESS STORIES</p>
    <h1>See our work in real spaces.</h1>
    <p>Explore real automotive and residential projects from Black Crown Tint. Each story shows the glass, the setting and the work through photos from our team.</p>
  </section>
  {projects.map(project => <section class="project-group">
    <div class="project-heading"><h2>{project.title}</h2><a href={project.href}>Explore this service &rarr;</a></div>
    <p class="project-summary">{project.summary}</p>
    <div class="project-grid">{project.photos.map(photo => <figure><img src={`/images/project-${String(photo.id).padStart(2,'0')}.webp`} width="768" height="1024" alt={photo.alt} loading="lazy" decoding="async" /></figure>)}</div>
  </section>)}
  <section class="project-cta">
    <h2>Let's plan your next tint project</h2>
    <a href={routes.contact} class="bc-cta-btn">Get a free quote</a>
    <p><a href={site.instagramHref}>Follow {site.instagram}</a></p>
  </section>
</BaseLayout>
<style>
.project-intro{padding:64px 24px 40px;color:#fff;max-width:850px;margin:auto;text-align:center}
.project-eyebrow{color:#ffb5dc;font-size:12px;font-weight:700;letter-spacing:.15em}
h1{font-size:clamp(34px,5vw,56px);line-height:1.1;margin:18px 0 20px}.project-intro>p:last-child{color:#b9b6c1;line-height:1.7}
.project-group{max-width:1180px;margin:auto;padding:32px 24px 48px}.project-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px;flex-wrap:wrap}.project-heading h2{font-size:clamp(24px,3vw,32px);color:#fff}.project-heading a{color:#ffb5dc}
.project-summary{color:#b9b6c1;line-height:1.7;max-width:760px;margin:0 0 24px}.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.project-grid figure{margin:0;background:#18181c;border-radius:16px;overflow:hidden}.project-grid img{display:block;width:100%;height:auto;aspect-ratio:3/4;object-fit:contain}
.project-cta{padding:64px 24px;text-align:center;color:#fff}.project-cta h2{font-size:30px;margin-bottom:24px}.project-cta>a{display:inline-block;background:#c81878;padding:16px 28px;border-radius:10px;font-weight:700}.project-cta p{margin-top:24px;color:#b9b6c1}
@media(max-width:800px){.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.project-grid{grid-template-columns:1fr}}
</style>
